---
import Layout from '@/components/Layout.astro';
---

<Layout title="Offline" noindex narrow>
  <div class="py-16 text-center">
    <h1 class="text-xl font-bold">You're offline</h1>
    <p class="mt-2 text-[rgb(var(--text-muted))]">
      This page hasn't been cached yet. Tools you've already opened still work — try one of those,
      or reconnect to load this one.
    </p>
    <a href="/" class="btn btn-primary mt-6">Go home</a>
  </div>
</Layout>
