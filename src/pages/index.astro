---
import Layout from '@/components/Layout.astro';
import ToolCard from '@/components/ToolCard.astro';
import CategoryCard from '@/components/CategoryCard.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/lib/site';
import { VISIBLE_TOOLS, categoriesWithCounts, TOOL_COUNT, CATEGORY_COUNT } from '@/lib/registry';
import { websiteJsonLd, organizationJsonLd } from '@/lib/seo';

const categories = categoriesWithCounts();
// Link paths must honour the deploy base (e.g. /browser-tools-platform on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featured = VISIBLE_TOOLS.filter((t) =>
  [
    'base64',
    'json-format',
    'hash',
    'uuid',
    'url-encode',
    'jwt-decode',
    'qr-code',
    'image-resize',
  ].includes(t.meta.id),
).slice(0, 8);
const pillars = [
  {
    icon: 'shield-check',
    title: 'Nothing is uploaded',
    text: 'Your files and text are processed by code running in your tab. They never touch a server.',
  },
  {
    icon: 'zap',
    title: 'Fast and offline',
    text: 'No round-trips. Load once and every tool keeps working without a connection.',
  },
  {
    icon: 'lock',
    title: 'No accounts, no tracking',
    text: 'No sign-up, no cookies, no analytics. Open source and independent.',
  },
];
---

<Layout
  title={site.name}
  description={site.description}
  path="/"
  jsonLd={[websiteJsonLd(), organizationJsonLd()]}
>
  <section class="border-b pb-14 pt-14 sm:pb-16 sm:pt-20">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-[rgb(var(--accent))]">
      Private by default
    </p>
    <h1
      class="mt-5 max-w-2xl text-[2rem] font-semibold leading-[1.08] tracking-[-0.03em] text-[rgb(var(--text))] sm:text-[3.25rem]"
    >
      {site.tagline}
    </h1>
    <p class="mt-5 max-w-lg leading-relaxed text-[rgb(var(--text-muted))]">
      {TOOL_COUNT} file and text utilities across {CATEGORY_COUNT} categories. Free, no sign-up, works
      offline.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`${base}/tools`} class="btn btn-primary">
        Browse all tools <Icon name="arrow-right" size={16} />
      </a>
      <button type="button" class="btn btn-ghost" data-open-search>
        <Icon name="search" size={16} /> Search
      </button>
    </div>
  </section>

  <section class="grid gap-px overflow-hidden border-b sm:grid-cols-3" aria-label="Why Toolbench">
    {
      pillars.map((p) => (
        <div class="py-6 sm:pr-8">
          <div class="flex items-center gap-2">
            <span class="text-[rgb(var(--text-faint))]" aria-hidden="true">
              <Icon name={p.icon} size={15} />
            </span>
            <h2 class="font-mono text-[11px] uppercase tracking-[0.14em] text-[rgb(var(--text-muted))]">
              {p.title}
            </h2>
          </div>
          <p class="mt-3 max-w-xs text-[13px] leading-relaxed text-[rgb(var(--text-muted))]">
            {p.text}
          </p>
        </div>
      ))
    }
  </section>

  {
    featured.length > 0 && (
      <section class="mt-14">
        <div class="flex items-end justify-between gap-4">
          <h2 class="text-lg font-semibold tracking-[-0.02em] text-[rgb(var(--text))]">
            Popular tools
          </h2>
          <a
            class="shrink-0 text-sm text-[rgb(var(--text-muted))] underline-offset-4 hover:text-[rgb(var(--accent))] hover:underline"
            href={`${base}/tools`}
          >
            All {TOOL_COUNT} tools
          </a>
        </div>
        <div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {featured.map((t) => (
            <ToolCard meta={t.meta} />
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-14">
    <div class="flex items-end justify-between gap-4">
      <h2 class="text-lg font-semibold tracking-[-0.02em] text-[rgb(var(--text))]">
        Browse by category
      </h2>
      <a
        class="shrink-0 text-sm text-[rgb(var(--text-muted))] underline-offset-4 hover:text-[rgb(var(--accent))] hover:underline"
        href={`${base}/categories`}
      >
        All categories
      </a>
    </div>
    <div class="mt-6 grid gap-x-10 sm:grid-cols-2">
      {categories.map((c) => <CategoryCard category={c} />)}
    </div>
  </section>

  <section
    class="mt-16 flex flex-col gap-4 border-t pt-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div>
      <h2 class="font-semibold tracking-[-0.01em] text-[rgb(var(--text))]">Install it as an app</h2>
      <p class="mt-1.5 max-w-lg text-[13px] leading-relaxed text-[rgb(var(--text-muted))]">
        {site.name} is a Progressive Web App. Add it to your home screen or desktop on Windows, macOS,
        Linux, Android and iOS. It then runs fullscreen and works offline.
      </p>
    </div>
    <a href={`${base}/about#install`} class="btn btn-ghost shrink-0">How to install</a>
  </section>
</Layout>

<script>
  document
    .querySelector('[data-open-search]')
    ?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('toolbench:search')));
</script>
