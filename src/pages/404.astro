---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';

// Link paths must honour the deploy base (e.g. /browser-tools-platform on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Page not found"
  description="The page you're looking for isn't here."
  path="/404"
  noindex
  narrow
>
  <div class="py-16 text-center">
    <p class="font-mono text-6xl font-bold text-[rgb(var(--accent))]" aria-hidden="true">404</p>
    <h1 class="mt-3 text-xl font-bold text-[rgb(var(--text))]">That page isn't here</h1>
    <p class="mx-auto mt-2 max-w-md text-[rgb(var(--text-muted))]">
      The page may have moved, or the link is broken. Try a search or browse everything.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href={`${base}/tools`} class="btn btn-primary">All tools <Icon name="arrow-right" size={16} /></a>
      <a href={`${base}/`} class="btn btn-ghost">Home</a>
      <button type="button" class="btn btn-ghost" data-open-search>
        <Icon name="search" size={16} /> Search
      </button>
    </div>
  </div>
</Layout>

<script>
  document
    .querySelector('[data-open-search]')
    ?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('toolbench:search')));
</script>
