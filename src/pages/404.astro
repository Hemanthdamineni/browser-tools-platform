---
import Layout from '@/components/Layout.astro';
import Icon from '@/components/Icon.astro';
---

<Layout title="Page not found" noindex narrow>
  <div class="py-16 text-center">
    <p class="text-6xl font-extrabold text-[rgb(var(--accent))]">404</p>
    <h1 class="mt-3 text-xl font-bold">That page isn't here</h1>
    <p class="mt-2 text-[rgb(var(--text-muted))]">
      The tool may have moved. Try a search or browse everything.
    </p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/tools" class="btn btn-primary">All tools <Icon name="arrow-right" size={16} /></a>
      <button type="button" class="btn btn-ghost" data-open-search>
        <Icon name="search" size={16} /> Search
      </button>
    </div>
  </div>
</Layout>

<script>
  document
    .querySelector('[data-open-search]')
    ?.addEventListener('click', () => window.dispatchEvent(new CustomEvent('toolbench:search')));
</script>
