---
import Layout from '@/components/Layout.astro';
import { GUIDES } from '@/lib/guides';
import { site } from '@/lib/site';
---

<Layout
  title="Guides"
  description={`Guides from ${site.name} on encoding, hashing, scheduling and accessibility — each one links straight to the tool that puts it into practice.`}
  path="/guides"
>
  <section class="mx-auto max-w-4xl">
    <div class="mt-4 max-w-2xl">
      <h1 class="text-2xl font-bold tracking-tight text-[rgb(var(--text))] sm:text-3xl">Guides</h1>
      <p class="mt-3 leading-relaxed text-[rgb(var(--text-muted))]">
        Short, practical write-ups on the concepts behind our tools. Each guide explains a topic in
        plain terms and then points you at the tool that does the work, so you can move from reading
        to doing without leaving the tab.
      </p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        GUIDES.map((guide) => (
          <a
            href={guide.path}
            class="group surface flex flex-col gap-2 rounded-lg p-5 transition-colors duration-200 hover:border-[rgb(var(--border-strong))] hover:bg-[rgb(var(--bg-subtle))]"
          >
            <h2
              class="font-semibold leading-snug tracking-[-0.01em] text-[rgb(var(--text))] group-hover:text-[rgb(var(--accent))]"
            >
              {guide.title}
            </h2>
            <p class="text-[13px] leading-relaxed text-[rgb(var(--text-muted))]">{guide.summary}</p>
          </a>
        ))
      }
    </div>

    <p class="mt-10 text-sm text-[rgb(var(--text-muted))]">
      Looking for a tool instead? Browse the full{' '}
      <a class="text-[rgb(var(--accent))] underline underline-offset-3" href="/tools">tool list</a>.
    </p>
  </section>
</Layout>