---
import { site } from '@/lib/site';
import { TOOL_COUNT } from '@/lib/registry';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const groups = Object.entries(site.footer);
// Asset/link paths must honour the deploy base (e.g. /browser-tools-platform on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="mt-20 border-t surface-subtle">
  <div class="mx-auto max-w-content px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-[1.4fr_1fr_1fr] sm:gap-8">
      <div>
        <a
          href={`${base}/`}
          class="inline-flex items-center gap-2.5 font-semibold tracking-tight"
          aria-label={`${site.shortName} home`}
        >
          <span
            class="grid h-7 w-7 place-items-center rounded-md"
            style="background-color: rgb(var(--text)); color: rgb(var(--bg))"
            aria-hidden="true"
          >
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M14.7 6.3a5 5 0 0 0-6.4 6.4L4 17v3h3l4.3-4.3a5 5 0 0 0 6.4-6.4L14 8.6l-1.6 1.6-1.6-1.6 3.9-3.9z"
              ></path></svg
            >
          </span>
          {site.shortName}
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-[rgb(var(--text-muted))]">
          {TOOL_COUNT} focused tools for everyday work. Private by default, fast by design.
        </p>
        <span class="chip mt-4"><Icon name="shield-check" size={14} /> Runs on your device</span>
      </div>

      {
        groups.map(([title, links]) => (
          <nav aria-label={title}>
            <div class="text-xs font-semibold uppercase tracking-[0.14em] text-[rgb(var(--text-faint))]">
              {title}
            </div>
            <ul class="mt-4 space-y-2.5 text-sm">
              {links.map((l) => (
                <li>
                  <a
                    class="text-[rgb(var(--text-muted))] transition-colors hover:text-[rgb(var(--accent))]"
                    href={l.href}
                  >
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-3 border-t pt-6 text-xs text-[rgb(var(--text-faint))] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. MIT licensed.</p>
      <div class="flex items-center gap-4">
        {
          site.social.github && (
            <a
              class="inline-flex items-center gap-1.5 transition-colors hover:text-[rgb(var(--accent))]"
              href={site.social.github}
              rel="noopener"
            >
              <Icon name="github" size={15} /> Source code
            </a>
          )
        }
      </div>
    </div>
  </div>
</footer>
