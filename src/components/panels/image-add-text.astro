---
/**
 * Panel for the "Add Text to Image" tool.
 *
 * The generic workbench cannot express a draggable text block, so the tool sets
 * `meta.panel = 'image-add-text'` and this component replaces it. It reuses the
 * shared option fields for everything the generic form can express, and adds a
 * live preview canvas plus a draggable position on top.
 *
 * The root deliberately does NOT carry `data-file-workbench`: FileWorkbench's
 * generic script binds itself to every `[data-file-workbench]` root and skips
 * only `data-signature-workbench`, so the marker would double-mount this page
 * (two runners on one `[data-run]`) and then crash on the hooks it requires but
 * this panel does not have (`[data-download-all]`). Panel tools are recognised
 * by the `[data-panel-workbench]` wrapper `PanelWorkbench` renders around them.
 *
 * The behaviour lives in `./image-add-text-panel.ts`, imported lazily from the
 * script block below so no drag code ships to pages that do not use it.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '@/components/workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
const options = meta.options ?? [];
// The position is expressed by dragging the preview, so its two numbers are
// rendered next to the canvas instead of in the generic grid.
const positionKeys = ['x', 'y'];
const gridOptions = options.filter((option) => !positionKeys.includes(option.key));
const defaultOf = (key: string, fallback: string) =>
  String(options.find((option) => option.key === key)?.default ?? fallback);
const xDefault = defaultOf('x', '50');
const yDefault = defaultOf('y', '85');
const examples = meta.examples ?? [];
const hintId = `${p}-drag-hint`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-image-add-text-panel
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose an image</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose an image file or drop it here"
  >
    <Icon name="image" size={26} class="opacity-60" />
    <p class="text-sm font-medium">
      Drop a PNG, JPEG or WebP here, or <span class="link">browse</span>
    </p>
    <p class="text-xs text-[rgb(var(--text-muted))]">The image never leaves your device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Write the text</h2>
  {
    examples.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((example, index) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={index}
            data-example-options={JSON.stringify(example.options ?? {})}
          >
            {example.title}
          </button>
        ))}
      </div>
    )
  }
  <div class="mt-3">
    <OptionsFields options={gridOptions} idPrefix={p} />
  </div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Drag it into place</h2>
  <div class="relative mt-3 overflow-hidden rounded-lg border" data-preview>
    <canvas
      class="block w-full"
      width="16"
      height="9"
      role="img"
      aria-label="Preview of the image with your text drawn on it"
      data-preview-canvas></canvas>
    <span
      class="pointer-events-none absolute rounded border-2 border-dashed"
      style="border-color: rgb(var(--accent))"
      aria-hidden="true"
      data-text-box
      hidden></span>
    <div
      class="absolute inset-0 cursor-move touch-none focus-visible:ring-2 focus-visible:ring-[rgb(var(--accent))]"
      data-drag-surface
      tabindex="0"
      role="group"
      aria-label="Text position on the image. Drag to move the text, or press the arrow keys."
      aria-describedby={hintId}
    >
    </div>
  </div>
  <p id={hintId} class="mt-2 text-xs leading-relaxed text-[rgb(var(--text-muted))]">
    Drag the block with the mouse or a finger, or focus the preview and press the arrow keys: each
    press moves the text by 1% of the image, or 10% while holding Shift. A click outside the block
    brings it to that spot.
  </p>
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    <div class="flex min-w-0 flex-col gap-1.5">
      <label for={`${p}-opt-x`} class="text-sm font-medium text-[rgb(var(--text))]">
        Horizontal position (%)
      </label>
      <input
        id={`${p}-opt-x`}
        class="field"
        type="number"
        min="0"
        max="100"
        step="0.5"
        value={xDefault}
        data-opt-key="x"
        data-opt-type="number"
        data-position="x"
        data-default-value={xDefault}
      />
    </div>
    <div class="flex min-w-0 flex-col gap-1.5">
      <label for={`${p}-opt-y`} class="text-sm font-medium text-[rgb(var(--text))]">
        Vertical position (%)
      </label>
      <input
        id={`${p}-opt-y`}
        class="field"
        type="number"
        min="0"
        max="100"
        step="0.5"
        value={yDefault}
        data-opt-key="y"
        data-opt-type="number"
        data-position="y"
        data-default-value={yDefault}
      />
    </div>
    <div class="flex items-end">
      <button type="button" class="btn btn-ghost" data-position-reset>Reset position</button>
    </div>
  </div>
  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-preview-status
    role="status"
    aria-live="polite"
  >
    Choose an image to see it here.
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Add text
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out motion-reduce:transition-none"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Adding text to an image needs JavaScript. Nothing is ever uploaded.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-image-add-text-panel]').forEach((panel) => {
    // The drag/preview code is loaded on demand: only this tool's page pays for it.
    void import('./image-add-text-panel')
      .then(({ mountImageAddTextPanel }) => mountImageAddTextPanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The text panel could not be loaded in this browser.';
        }
      });
  });
</script>
