---
/**
 * Scientific Calculator panel.
 *
 * The `upgrade-calculator-scientific` tool opts into this panel via
 * `meta.panel = 'scientific-calculator'`.
 *
 * The panel provides an on-screen keypad, live expression field, options,
 * example buttons, and history. Evaluation is delegated to the tool's
 * safe recursive-descent parser (no eval / new Function).
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '../workbench/OptionsFields.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const options = meta.options ?? [];
const examples = meta.examples ?? [];
const id = meta.id;
const headingId = `${id}-heading`;
const exprId = `${id}-expr`;
const resultId = `${id}-result`;
const errorId = `${id}-error`;
const historyId = `${id}-history`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-scientific-calculator
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <h2 id={headingId} class="text-lg font-semibold text-[rgb(var(--text))]">
    {meta.name}
  </h2>

  <p class="mt-1 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    {meta.summary}
  </p>

  <!-- Example buttons -->
  {
    examples.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-2" data-examples>
        {examples.map((ex, idx) => (
          <button
            type="button"
            class="btn btn-subtle btn-sm"
            data-example-index={idx}
            data-example-input={ex.input}
            data-example-title={ex.title}
          >
            {ex.title}
          </button>
        ))}
      </div>
    )
  }

  <!-- Expression input + keypad -->
  <div class="mt-4 space-y-3">
    <label for={exprId} class="sr-only">Expression</label>
    <textarea
      id={exprId}
      class="field w-full font-mono text-sm"
      rows={3}
      placeholder="Type an expression or use the keypad…"
      aria-describedby={`${exprId}-hint`}
      spellcheck="false"
      data-expression
    ></textarea>
    <p id={`${exprId}-hint`} class="text-xs text-[rgb(var(--text-muted))]">
      Keyboard input works too. Keypad buttons append to the expression.
    </p>
  </div>

  <!-- Keypad -->
  <div class="mt-3 overflow-x-auto pb-1" data-keypad>
    <table class="w-full border-collapse" role="grid" aria-label="Scientific calculator keypad">
      <tbody>
        <!-- Row 1: Constants & Functions -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="pi">π</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="e">e</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="phi">φ</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="tau">τ</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="sqrt2">√2</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="ln2">ln2</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="ln10">ln10</button></td>
        </tr>
        <!-- Row 2: Trig -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="sin">sin</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="cos">cos</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="tan">tan</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="asin">asin</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="acos">acos</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="atan">atan</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="atan2">atan2</button></td>
        </tr>
        <!-- Row 3: Hyperbolic -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="sinh">sinh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="cosh">cosh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="tanh">tanh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="asinh">asinh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="acosh">acosh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="atanh">atanh</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="deg2rad">deg→rad</button></td>
        </tr>
        <!-- Row 4: Log/Exp -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="ln">ln</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="log">log</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="log2">log2</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="log10">log10</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="exp">exp</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="expm1">expm1</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="log1p">log1p</button></td>
        </tr>
        <!-- Row 5: Powers & Roots -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="^">x<sup>y</sup></button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="sqrt">√</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="cbrt">∛</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="pow10">10<sup>x</sup></button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="exp10">e<sup>x</sup></button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="hypot">hypot</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="!">x!</button></td>
        </tr>
        <!-- Row 6: Number row 7-8-9 + operators -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="7">7</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="8">8</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="9">9</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="(">(</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key=")">)</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="/">÷</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="*">×</button></td>
        </tr>
        <!-- Row 7: Number row 4-5-6 + operators -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="4">4</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="5">5</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="6">6</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="+">+</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="-">−</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="%">%</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="nPr">nPr</button></td>
        </tr>
        <!-- Row 8: Number row 1-2-3 + operators -->
        <tr>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="1">1</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="2">2</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="3">3</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="nCr">nCr</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="gcd">gcd</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="lcm">lcm</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key="rand">rand</button></td>
        </tr>
        <!-- Row 9: 0 . , = and actions -->
        <tr>
          <td colspan="2"><button type="button" class="btn btn-subtle btn-sm key-btn w-full" data-key="0">0</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key=".">.</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-key=",">,</button></td>
          <td><button type="button" class="btn btn-primary key-btn" data-action="run">=</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-action="clear">C</button></td>
          <td><button type="button" class="btn btn-subtle btn-sm key-btn" data-action="backspace">⌫</button></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- Options -->
  {
    options.length > 0 && (
      <details class="mt-4 rounded-lg border" open>
        <summary class="flex cursor-pointer items-center gap-2 px-4 py-3 text-sm font-medium text-[rgb(var(--text))] select-none">
          Options
        </summary>
        <div class="p-4 pt-0">
          <OptionsFields options={options} idPrefix={id} />
        </div>
      </details>
    )
  }

  <!-- Actions -->
  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button
      type="button"
      class="btn btn-primary"
      data-action="run"
      aria-label="Evaluate expression"
    >
      Evaluate
    </button>
    <button
      type="button"
      class="btn btn-subtle btn-sm"
      data-action="clear"
      aria-label="Clear expression and result"
    >
      Clear
    </button>
    <button
      type="button"
      class="btn btn-subtle btn-sm"
      data-action="clear-history"
      aria-label="Clear calculation history"
    >
      Clear History
    </button>
  </div>

  <!-- Progress (hidden by default) -->
  <div class="mt-4" hidden data-progress-wrap>
    <div class="flex items-center gap-3">
      <div class="h-1.5 flex-1 max-w-xs rounded-full bg-[rgb(var(--bg-subtle))]" role="progressbar" aria-valuemin="0" aria-valuemax="100">
        <div class="h-full rounded-full bg-[rgb(var(--accent))] transition-all" style="width: 0%" data-progress-bar></div>
      </div>
      <span class="text-sm text-[rgb(var(--text-muted))]" data-progress-text>Preparing…</span>
    </div>
  </div>

  <!-- Error region -->
  <div
    id={errorId}
    class="mt-4 rounded-lg border border-[rgb(var(--danger))] bg-[rgb(var(--danger))]/10 p-3 text-sm text-[rgb(var(--danger))]"
    hidden
    data-error
    role="alert"
  ></div>

  <!-- Result region -->
  <div
    id={resultId}
    class="mt-4"
    hidden
    data-result-wrap
    aria-live="polite"
  ></div>

  <!-- History region -->
  <div id={historyId} class="mt-4" hidden data-history-wrap>
    <h3 class="text-sm font-medium text-[rgb(var(--text))]">History</h3>
    <ul class="mt-2 space-y-1.5 max-h-64 overflow-y-auto" data-history-list></ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-scientific-calculator]').forEach((root) => {
    void import('./scientific-calculator')
      .then(({ mountScientificCalculatorPanel }) => mountScientificCalculatorPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The scientific calculator panel could not be loaded in this browser.';
        }
      });
  });
</script>

<style>
  /* Keypad buttons */
  .key-btn {
    @apply min-w-[2.5rem] h-8 sm:h-9 flex items-center justify-center text-sm font-mono transition-colors;
  }
  .key-btn:hover {
    @apply bg-[rgb(var(--bg-subtle))];
  }
  .key-btn:active {
    @apply bg-[rgb(var(--accent))]/20;
  }
  .key-btn:focus-visible {
    @apply outline-none ring-2 ring-[rgb(var(--accent))] ring-offset-2 ring-offset-[rgb(var(--bg))];
  }

  /* Keypad table */
  [data-keypad] table {
    @apply text-[rgb(var(--text))];
  }
  [data-keypad] td {
    @apply px-0.5 py-0.5;
  }

  /* Expression field */
  [data-expression] {
    @apply resize-none;
  }
  [data-expression]:focus {
    @apply outline-none ring-2 ring-[rgb(var(--accent))] ring-offset-2 ring-offset-[rgb(var(--bg))];
  }

  /* Result area */
  [data-result-wrap] textarea.field {
    @apply bg-[rgb(var(--bg-subtle))] border-[rgb(var(--border))] text-[rgb(var(--text))];
  }

  /* History items */
  [data-history-list] button {
    @apply w-full text-left px-3 py-1.5 rounded border border-[rgb(var(--border))] text-sm font-mono text-[rgb(var(--text))] hover:bg-[rgb(var(--bg-subtle))] transition-colors;
  }
  [data-history-list] button:focus-visible {
    @apply outline-none ring-2 ring-[rgb(var(--accent))] ring-offset-2 ring-offset-[rgb(var(--bg))];
  }

  /* Example buttons */
  [data-examples] button:focus-visible {
    @apply outline-none ring-2 ring-[rgb(var(--accent))] ring-offset-2 ring-offset-[rgb(var(--bg))];
  }
</style>