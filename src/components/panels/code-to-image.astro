---
/**
 * The Code to Image panel.
 *
 * The generic text workbench cannot express a live preview of a rendered code
 * card, so the tool opts into this panel via `meta.panel = 'code-to-image'`.
 * The panel keeps the `data-panel-workbench` marker (added by PanelWorkbench)
 * so the shared sweep treats it like every other tool, while
 * `code-to-image-panel.ts` — loaded on demand — drives the highlighting, the
 * layout and the SVG/PNG exports. All option names and the render contract
 * come from that panel module; this markup only has to match its selectors.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '../workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const examples = meta.examples ?? [];
const options = meta.options ?? [];
const p = meta.id;
/** The panel opens with the first example so the preview is never blank. */
const opening = examples[0]?.input ?? '';
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-code-to-image
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  {
    examples.length > 0 && (
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((ex, i) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={i}
            data-example-payload={JSON.stringify({
              input: ex.input ?? '',
              options: ex.options ?? {},
            })}
          >
            {ex.title}
          </button>
        ))}
      </div>
    )
  }

  <div class="grid gap-4 lg:grid-cols-2">
    <div class="flex min-w-0 flex-col">
      <label class="mb-1.5 text-sm font-medium" for={`${p}-source`}>Code snippet</label>
      <textarea
        id={`${p}-source`}
        class="field !min-h-[20rem] flex-1 font-mono text-[13px]"
        rows="16"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        data-source
        set:text={opening}
      />
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" data-status role="status" aria-live="polite"
      ></p>
    </div>

    <div class="flex min-w-0 flex-col">
      <div class="mb-1.5 flex items-center justify-between gap-3">
        <span class="text-sm font-medium">Preview</span>
        <div class="flex items-center gap-2 text-xs text-[rgb(var(--text-muted))]">
          <span>Zoom</span>
          <input
            class="h-1.5 w-24 accent-[rgb(var(--accent))]"
            type="range"
            min="0.5"
            max="3"
            step="0.1"
            value="1"
            data-zoom
            aria-label="Preview zoom"
          />
          <button type="button" class="link text-xs" data-zoom-reset>reset</button>
        </div>
      </div>
      <iframe
        class="min-h-[20rem] w-full flex-1 rounded-md border"
        style="background-color: rgb(var(--surface));"
        data-preview
        sandbox=""
        title="Rendered code image"
        referrerpolicy="no-referrer"></iframe>
    </div>
  </div>

  {
    options.length > 0 && (
      <details class="mt-4 rounded-lg border" open>
        <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
        <div class="border-t p-3" data-options>
          <OptionsFields options={options} idPrefix={p} />
        </div>
      </details>
    )
  }

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run>
      <Icon name="image" size={16} />
      <span data-run-label>Render image</span>
    </button>
    <label class="flex cursor-pointer items-center gap-2 text-sm text-[rgb(var(--text-muted))]">
      <input type="checkbox" class="h-4 w-4 rounded" data-live checked />
      Update as I type
    </label>
    <button type="button" class="btn btn-ghost" data-export-svg>
      <Icon name="download" size={16} />
      Export SVG
    </button>
    <button type="button" class="btn btn-ghost" data-export-png>
      <Icon name="download" size={16} />
      Export PNG
    </button>
    <button type="button" class="btn btn-ghost" data-clear>
      <Icon name="x" size={16} />
      Clear
    </button>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between gap-3">
      <span class="text-sm font-semibold text-[rgb(var(--text))]">Result</span>
    </div>
    <p class="mb-1 text-xs text-[rgb(var(--text-muted))]">
      The serialised SVG below is exactly what Export SVG saves, and what the PNG export
      rasterises onto a canvas. The preview above is the same markup inside a sandboxed iframe.
    </p>
    <img class="max-h-80 w-auto rounded-lg border" alt="Rendered code image" data-image hidden />
    <details class="mt-2 rounded-lg border">
      <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">SVG source</summary>
      <div class="border-t p-3">
        <pre class="max-h-64 overflow-auto rounded-lg border p-3 text-xs leading-relaxed" data-output></pre>
      </div>
    </details>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Turning code into an image needs JavaScript — the highlighting and the PNG/SVG export
      cannot run without it.
    </p>
  </noscript>
</section>

<style>
  /*
   * `.btn` sets `display: inline-flex` in the components layer, which beats
   * Tailwind's base-layer `[hidden] { display: none }` — so a hidden element
   * would still be on screen. This panel toggles elements with the `hidden`
   * attribute, so the attribute has to win here.
   */
  [hidden] {
    display: none !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-code-to-image]').forEach((root) => {
    // Loaded on demand: the panel is only used by this tool, and Shiki (plus
    // the WebAssembly engine and the grammars) is pulled in lazily by the
    // panel module when the first snippet is highlighted.
    void import('./code-to-image-panel')
      .then(({ mountCodeToImagePanel }) => mountCodeToImagePanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent =
            'The Code to Image panel could not be loaded in this browser.';
        }
      });
  });
</script>
