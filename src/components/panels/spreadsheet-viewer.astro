---
/**
 * The spreadsheet viewer panel: drop a workbook, switch sheets and scan a
 * capped preview, then convert the active sheet to CSV, JSON or XLSX.
 *
 * The generic file workbench cannot express this flow — a live sheet tab bar
 * over a scrollable grid — so the tool opts into this panel via
 * `meta.panel = 'spreadsheet-viewer'`.
 *
 * The panel only collects the file and the sheet/format the user picked. The
 * conversion itself happens in the tool worker, through the tool's own `run()`.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-spreadsheet-viewer-panel
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose a spreadsheet</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a spreadsheet file or drop it here"
  >
    <Icon name="download" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a spreadsheet here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">
      XLSX, XLS, ODS or CSV. The file stays on your device.
    </p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Preview the sheets</h2>
  <p
    class="mt-1 text-xs text-[rgb(var(--text-muted))]"
    data-status
    role="status"
    aria-live="polite"
  >
    Choose a spreadsheet to see its sheets and grid.
  </p>

  <div class="mt-3 flex flex-wrap items-center gap-2" data-tabs role="tablist" aria-label="Sheets">
  </div>
  <p class="mt-2 text-xs text-[rgb(var(--text-muted))]" data-summary></p>
  <p class="mt-1 text-xs text-[rgb(var(--accent))]" data-header-hint hidden>
    The first row reads as a header — JSON export will use it for the object keys.
  </p>
  <div class="mt-3" data-grid></div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Convert</h2>
  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div>
      <label class="text-xs font-medium" for={`${p}-format`}>Convert the active sheet to</label>
      <select class="field mt-1" id={`${p}-format`} data-format>
        <option value="csv">CSV</option>
        <option value="json">JSON</option>
        <option value="xlsx">XLSX (whole workbook)</option>
      </select>
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-max-rows`}>Preview rows</label>
      <select class="field mt-1" id={`${p}-max-rows`} data-max-rows>
        <option value="50">50</option>
        <option value="200" selected>200</option>
        <option value="500">500</option>
        <option value="1000">1000</option>
      </select>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Convert
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]">Results</span>
    </div>
    <div class="mb-3 min-w-0" data-report hidden></div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-spreadsheet-viewer-panel]').forEach((panel) => {
    // Loaded on demand: the spreadsheet UI — and SheetJS, which it pulls in —
    // only ships to the pages that actually use it.
    void import('./spreadsheet-viewer-panel')
      .then(({ mountSpreadsheetViewerPanel }) => mountSpreadsheetViewerPanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The spreadsheet viewer could not be loaded in this browser.';
        }
      });
  });
</script>
