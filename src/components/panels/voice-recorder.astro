---
/**
 * The voice recorder panel.
 *
 * Recording a voice memo needs `getUserMedia`, a live level meter and a
 * record/pause/stop flow the generic file workbench cannot express, so this
 * tool opts into a panel via `meta.panel = 'voice-recorder'`. The behaviour
 * lives in `./voice-recorder-panel.ts` and is loaded on demand.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-voice-recorder
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2 class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]">
      <Icon name="audio-lines" size={18} /> Voice recorder
    </h2>
    <span class="chip">On-device</span>
  </div>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Record your voice in this tab, watch the level, pause and resume, then play the take back,
    download it or send it to the trim tool. The recording stays on your device — nothing is
    uploaded.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-vr-error
    hidden
  >
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-vr-mic aria-pressed="false">
      <Icon name="audio-lines" size={16} /> Microphone
    </button>
    <button type="button" class="btn btn-subtle" data-vr-record disabled>
      <Icon name="play" size={16} /> Record
    </button>
    <button type="button" class="btn btn-ghost" data-vr-pause hidden>
      <Icon name="stop" size={14} /> Pause
    </button>
    <button type="button" class="btn btn-subtle" data-vr-resume hidden>
      <Icon name="play" size={14} /> Resume
    </button>
    <button type="button" class="btn btn-ghost" data-vr-stop hidden>
      <Icon name="stop" size={14} /> Stop recording
    </button>
    <button type="button" class="btn btn-ghost" data-vr-discard hidden>
      Discard
    </button>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-4">
    <span class="flex items-center gap-2 text-sm font-medium text-[rgb(var(--text))]">
      <span
        class="inline-block h-2.5 w-2.5 animate-pulse rounded-full"
        style="background-color: rgb(var(--danger))"
        data-vr-rec-badge
        aria-hidden="true"
        hidden
      >
      </span>
      <span class="font-mono text-lg tabular-nums text-[rgb(var(--text))]" data-vr-timer role="timer"
        >0:00</span
      >
      <span class="text-xs text-[rgb(var(--text-muted))]">elapsed</span>
    </span>
    <label class="flex items-center gap-2 text-sm text-[rgb(var(--text-muted))]">
      <span class="text-xs font-medium">Format</span>
      <select class="field" data-vr-format>
        <option value="wav">WAV (PCM)</option>
        <option value="webm">WebM (Opus)</option>
      </select>
    </label>
  </div>

  <div class="mt-4 rounded-lg border p-3" data-vr-meter-box>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <span class="text-sm font-medium text-[rgb(var(--text))]">Input level</span>
      <span class="flex items-center gap-2">
        <span class="font-mono text-sm tabular-nums text-[rgb(var(--text))]" data-vr-level-readout
          >—</span
        >
        <span class="text-xs text-[rgb(var(--text-muted))]" data-vr-level-word>No signal</span>
      </span>
    </div>
    <div
      class="relative mt-1.5 h-3 overflow-hidden rounded-full"
      style="background-color: rgb(var(--bg-inset))"
      aria-hidden="true"
      data-vr-meter
    >
      <div
        class="absolute inset-y-0 left-0 rounded-full"
        style="width: 0%; background-color: rgb(var(--accent))"
        data-vr-meter-fill
      >
      </div>
      <div
        class="absolute inset-y-0 w-0.5 rounded-full"
        style="left: 0%; background-color: rgb(var(--text))"
        data-vr-meter-peak
      >
      </div>
    </div>
    <!-- The moving bar cannot be read out by a screen reader, so the level is
         also announced in a polite live region (throttled, see the panel). -->
    <p class="sr-only" data-vr-live role="status" aria-live="polite"></p>
  </div>

  <p
    class="mt-3 text-sm text-[rgb(var(--text-muted))]"
    data-vr-status
    role="status"
    aria-live="polite"
  >
    Microphone off. Press “Microphone” to begin.
  </p>

  <div class="mt-4" data-vr-clip-wrap hidden>
    <h3 class="text-sm font-semibold text-[rgb(var(--text))]">Your take</h3>
    <audio
      class="mt-2 w-full"
      controls
      preload="metadata"
      data-vr-audio
      aria-label="Recorded voice take"
    >
    </audio>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <a class="btn btn-subtle btn-sm" data-vr-download href="#" download>Download</a>
      <a class="btn btn-ghost btn-sm" data-vr-trim href="/tools/audio-trim">
        Trim it next
        <Icon name="arrow-right" size={14} />
      </a>
    </div>
    <p class="mt-2 text-xs text-[rgb(var(--text-muted))]" data-vr-clip-meta></p>
  </div>

  <div class="mt-5" data-vr-result-wrap hidden>
    <h3 class="mb-2 text-sm font-semibold text-[rgb(var(--text))]">Saved take</h3>
    <div class="min-w-0" data-vr-report hidden></div>
    <ul class="space-y-2" data-vr-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-vr-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      The voice recorder needs JavaScript — the browser’s audio APIs cannot run without it.
    </p>
  </noscript>
</section>

<style>
  /*
   * `.btn` sets `display: inline-flex` in the components layer, which beats
   * Tailwind's base-layer `[hidden] { display: none }` — so a hidden button
   * would still be on screen. This panel toggles buttons with the `hidden`
   * attribute, so the attribute has to win here.
   */
  [hidden] {
    display: none !important;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-voice-recorder]').forEach((root) => {
    // Loaded on demand: the recorder panel is only used by the voice recorder.
    void import('./voice-recorder-panel')
      .then(({ mountVoiceRecorderPanel }) => mountVoiceRecorderPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-vr-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The voice recorder panel could not be loaded in this browser.';
        }
      });
  });
</script>