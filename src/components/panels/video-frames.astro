---
import type { ToolMeta } from '@/lib/types';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const id = meta.id;
const headingId = `${id}-heading`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-panel-workbench
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <h1 id={headingId} class="text-xl font-semibold">{meta.name}</h1>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--muted))]">
    {meta.description}
  </p>

  <div class="mt-4 flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <label class="label" for="vf-file">Video file</label>
      <input
        type="file"
        id="vf-file"
        class="input flex-1"
        accept="video/*,.mp4,.m4v,.mov,.webm,.mkv,.ogv,.ts"
      />
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <label class="label" for="vf-mode">Mode</label>
      <select id="vf-mode" class="select w-full sm:w-64">
        <option value="interval">Interval (every N seconds)</option>
        <option value="thumbnail">Thumbnail (first frame per segment)</option>
      </select>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <label class="label" for="vf-interval">Interval (seconds)</label>
      <input
        type="number"
        id="vf-interval"
        class="input w-24"
        min="1"
        max="30"
        step="1"
        value="5"
      />
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <label class="label" for="vf-count">Max frames</label>
      <input type="number" id="vf-count" class="input w-24" min="1" max="50" step="1" value="10" />
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <label class="label" for="vf-width">Thumbnail width</label>
      <input
        type="number"
        id="vf-width"
        class="input w-24"
        min="100"
        max="1280"
        step="10"
        value="320"
      />
      <span class="text-sm text-[rgb(var(--muted))]">px</span>
    </div>

    <div class="flex items-center gap-3">
      <button class="btn" data-vf-extract disabled>Extract Frames</button>
      <span class="text-sm text-[rgb(var(--muted))]" data-vf-status>Select a video file</span>
    </div>

    <div
      class="grid gap-3"
      data-vf-preview-grid
      style="grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));"
      hidden
    >
      <!-- Preview thumbnails will be inserted here -->
    </div>

    <div class="flex items-center gap-3" hidden data-vf-download-wrap>
      <button class="btn-secondary" data-vf-download>Download all as ZIP</button>
    </div>
  </div>

  <noscript>
    <p class="alert alert-warning mt-4">
      This tool requires JavaScript to extract frames using WebCodecs.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-panel-workbench][data-tool-id="video-frames"]').forEach((root) => {
    void import('./video-frames')
      .then(({ mountVideoFramesWorkbench }) => mountVideoFramesWorkbench(root))
      .catch(() => {
        const status = root.querySelector<HTMLElement>('[data-vf-status]');
        if (status) {
          status.textContent = 'The video frames extractor could not be loaded in this browser.';
        }
      });
  });
</script>
