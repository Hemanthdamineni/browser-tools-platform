---
/**
 * The video trimmer panel: choose a clip, scrub to the in and out points and
 * cut it.
 *
 * The generic file workbench cannot express this flow — a live preview, a
 * scrub bar with two draggable handles and a readout of the selected range —
 * so the tool opts into this panel via `meta.panel = 'video-trim'`.
 *
 * The panel only collects the file and the cut points. The cut itself happens
 * in the tool worker, through the tool's own `run()`.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-video-trim-panel
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose the video</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a video file or drop it here"
  >
    <Icon name="download" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a video here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">
      MP4, MOV, WebM, MKV, MPEG-TS or Ogg. The file stays on your device.
    </p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">
    2 · Pick the in and out points
  </h2>
  <p
    class="mt-1 text-xs text-[rgb(var(--text-muted))]"
    data-status
    role="status"
    aria-live="polite"
  >
    Choose a video to see its timeline.
  </p>

  <div class="mt-3" data-stage hidden>
    <video
      class="w-full max-w-2xl rounded-lg border bg-black"
      data-video
      controls
      playsinline
      preload="metadata"
      aria-label="Preview of the chosen video"></video>

    <div
      class="relative mt-3 h-10 touch-none select-none rounded-lg border"
      style="background-color: rgb(var(--bg-inset))"
      data-scrub
    >
      <div
        class="absolute inset-y-0 rounded-md"
        style="background-color: rgb(var(--accent-soft)); left: 0%; width: 100%"
        data-range
      >
      </div>
      <div
        class="absolute inset-y-0 w-px"
        style="left: 0%; background-color: rgb(var(--text-faint))"
        data-playhead
      >
      </div>
      <div
        class="absolute inset-y-0 w-1.5 -translate-x-1/2 cursor-ew-resize rounded-full"
        style="left: 0%; background-color: rgb(var(--accent))"
        data-handle="start"
        role="slider"
        tabindex="0"
        aria-label="In point"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
        aria-valuetext="0:00"
      >
      </div>
      <div
        class="absolute inset-y-0 w-1.5 -translate-x-1/2 cursor-ew-resize rounded-full"
        style="left: 100%; background-color: rgb(var(--accent))"
        data-handle="end"
        role="slider"
        tabindex="0"
        aria-label="Out point"
        aria-valuemin="0"
        aria-valuemax="0"
        aria-valuenow="0"
        aria-valuetext="0:00"
      >
      </div>
    </div>

    <div class="mt-3 flex flex-wrap items-end gap-3">
      <div>
        <label class="text-xs font-medium" for={`${p}-start`}>In point</label>
        <input
          class="field mt-1 !w-32"
          id={`${p}-start`}
          type="text"
          inputmode="numeric"
          placeholder="0:00"
          data-start
        />
      </div>
      <div>
        <label class="text-xs font-medium" for={`${p}-end`}>Out point</label>
        <input
          class="field mt-1 !w-32"
          id={`${p}-end`}
          type="text"
          inputmode="numeric"
          placeholder="0:00"
          data-end
        />
      </div>
      <p class="text-xs text-[rgb(var(--text-muted))]" data-duration></p>
    </div>
    <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
      Drag the two handles, or type a time. A stream copy can only cut on a key frame, so the clip
      may start a little before the in point.
    </p>
  </div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Cut it</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-2">
    <div>
      <label class="text-xs font-medium" for={`${p}-format`}>Output container</label>
      <select class="field mt-1" id={`${p}-format`} data-format>
        <option value="source">Same as the source (fastest)</option>
        <option value="mp4">MP4</option>
        <option value="webm">WebM</option>
        <option value="mkv">Matroska (MKV)</option>
      </select>
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-copy-mode`}>How to cut</label>
      <select class="field mt-1" id={`${p}-copy-mode`} data-copy-mode>
        <option value="preferred">Copy when possible (recommended)</option>
        <option value="forced">Copy only — leave out what cannot be copied</option>
        <option value="never">Always re-encode</option>
      </select>
    </div>
  </div>
  <label class="mt-3 flex items-center gap-2 text-sm">
    <input type="checkbox" checked data-keep-audio />
    Keep the audio track
  </label>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Trim video
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]">Results</span>
    </div>
    <div class="mb-3 min-w-0" data-report hidden></div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-video-trim-panel]').forEach((panel) => {
    // Loaded on demand: the trimmer's UI only ships to the pages that use it.
    void import('./video-trim-panel')
      .then(({ mountVideoTrimPanel }) => mountVideoTrimPanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The video trimmer could not be loaded in this browser.';
        }
      });
  });
</script>
