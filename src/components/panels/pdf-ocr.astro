---
/**
 * The PDF OCR workbench: choose a scanned PDF, pick the language and render
 * scale, then let the tool write a hidden, searchable text layer over every
 * page. The heavy lifting — rendering each page and running Tesseract —
 * happens in `pdf-ocr.tool.ts`, so this panel only drives the options and the
 * progress bar.
 *
 * The generic file workbench cannot express a language picker, a render-scale
 * slider and a page-range field together, so the tool opts into this panel via
 * `meta.panel = 'pdf-ocr'`.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';
import { OCR_LANGUAGES, OCR_MODES } from '@/tools/image/ocr-languages';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
const scaleOption = meta.options?.find((option) => option.key === 'scale');
const scaleMin = scaleOption?.type === 'range' ? scaleOption.min : 1;
const scaleMax = scaleOption?.type === 'range' ? scaleOption.max : 4;
const scaleDefault = scaleOption?.type === 'range' ? scaleOption.default : 2;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-pdf-ocr-workbench
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose the PDF</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a PDF file or drop it here"
  >
    <Icon name="file-text" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a scanned PDF here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">The file never leaves your device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Reading options</h2>
  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div>
      <label class="text-xs font-medium" for={`${p}-language`}>Language</label>
      <select class="field mt-1 !w-56" id={`${p}-language`} data-language>
        {
          OCR_LANGUAGES.map((language) => (
            <option value={language.code} selected={language.code === 'eng'}>
              {language.label}
            </option>
          ))
        }
      </select>
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-mode`}>Text layout</label>
      <select class="field mt-1 !w-56" id={`${p}-mode`} data-mode>
        {
          OCR_MODES.map((mode) => (
            <option value={mode.value} selected={mode.value === 'auto'}>
              {mode.label}
            </option>
          ))
        }
      </select>
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-pages`}>Pages</label>
      <input
        class="field mt-1 !w-40"
        id={`${p}-pages`}
        data-pages
        type="text"
        value="all"
        placeholder="all or 1,3-5"
        autocomplete="off"
        spellcheck="false"
      />
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-scale`}>
        Render scale <span data-scale-value>{scaleDefault}×</span>
      </label>
      <input
        class="mt-2 block w-44 accent-[rgb(var(--accent))]"
        id={`${p}-scale`}
        data-scale
        type="range"
        min={scaleMin}
        max={scaleMax}
        step="1"
        value={String(scaleDefault)}
      />
    </div>
  </div>
  <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
    A higher render scale gives the OCR more detail to read, at the cost of memory and time.
  </p>

  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-plan-status
    role="status"
    aria-live="polite"
  >
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Make it searchable
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
    <ul class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 text-xs sm:grid-cols-3" data-stats></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Making a PDF searchable needs JavaScript. You can still download the PDF and OCR it in a
      desktop application.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pdf-ocr-workbench]').forEach((root) => {
    // Loaded on demand: the OCR panel is only used by the PDF OCR tool.
    void import('./pdf-ocr-panel')
      .then(({ mountPdfOcrPanel }) => mountPdfOcrPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The OCR panel could not be loaded in this browser.';
        }
      });
  });
</script>
