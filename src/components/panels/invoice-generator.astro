---
/**
 * The invoice workbench: fill in the sender and recipient, add line items with
 * quantity, unit price and tax rate, set a discount, drop in an optional logo,
 * and download a clean A4 PDF. The live totals refresh as you type, and
 * your draft is saved in your browser only.
 *
 * The generic text workbench cannot express this form (repeated line items,
 * a logo upload, a live totals block), so the tool opts into this panel via
 * `meta.panel = 'invoice-generator'`.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-invoice-generator-workbench
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  <div class="grid gap-6 lg:grid-cols-[1fr_300px]">
    <div class="space-y-6">
      <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Sender &amp; recipient</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <fieldset class="space-y-2.5">
          <legend class="text-xs font-medium text-[rgb(var(--text-muted))]">From</legend>
          <input class="field" data-from-name placeholder="Your name / company" />
          <input class="field" data-from-line1 placeholder="Street address" />
          <input class="field" data-from-line2 placeholder="Address line 2" />
          <div class="grid grid-cols-2 gap-2.5">
            <input class="field" data-from-city placeholder="City" />
            <input class="field" data-from-postal placeholder="Postal code" />
          </div>
          <input class="field" data-from-country placeholder="Country" />
          <input class="field" type="email" data-from-email placeholder="Email" />
          <input class="field" data-from-phone placeholder="Phone" />
        </fieldset>
        <fieldset class="space-y-2.5">
          <legend class="text-xs font-medium text-[rgb(var(--text-muted))]">Bill To</legend>
          <input class="field" data-to-name placeholder="Recipient name / company" />
          <input class="field" data-to-line1 placeholder="Street address" />
          <input class="field" data-to-line2 placeholder="Address line 2" />
          <div class="grid grid-cols-2 gap-2.5">
            <input class="field" data-to-city placeholder="City" />
            <input class="field" data-to-postal placeholder="Postal code" />
          </div>
          <input class="field" data-to-country placeholder="Country" />
          <input class="field" type="email" data-to-email placeholder="Email" />
          <input class="field" data-to-phone placeholder="Phone" />
        </fieldset>
      </div>

      <h2 class="text-base font-semibold text-[rgb(var(--text))]">2 · Invoice details</h2>
      <div class="grid gap-3 sm:grid-cols-4">
        <div>
          <label class="text-xs font-medium" for={`${p}-number`}>Invoice number</label>
          <input class="field mt-1" id={`${p}-number`} data-invoice-number placeholder="INV-0001" />
        </div>
        <div>
          <label class="text-xs font-medium" for={`${p}-issue`}>Issue date</label>
          <input class="field mt-1" id={`${p}-issue`} data-issue-date type="date" />
        </div>
        <div>
          <label class="text-xs font-medium" for={`${p}-due`}>Due date</label>
          <input class="field mt-1" id={`${p}-due`} data-due-date type="date" />
        </div>
        <div>
          <label class="text-xs font-medium" for={`${p}-currency`}>Currency</label>
          <select class="field mt-1" id={`${p}-currency`} data-currency>
            <option value="USD" selected>USD — $</option>
            <option value="EUR">EUR — €</option>
            <option value="GBP">GBP — £</option>
            <option value="JPY">JPY — ¥</option>
            <option value="CAD">CAD — $</option>
            <option value="AUD">AUD — $</option>
            <option value="CHF">CHF</option>
            <option value="INR">INR — ₹</option>
            <option value="BRL">BRL — R$</option>
          </select>
        </div>
      </div>

      <h2 class="text-base font-semibold text-[rgb(var(--text))]">3 · Line items</h2>
      <div class="space-y-2">
        <div
          class="grid grid-cols-[1fr_64px_96px_64px_auto] gap-2 text-xs font-medium text-[rgb(var(--text-muted))]"
        >
          <span>Description</span>
          <span class="text-right">Qty</span>
          <span class="text-right">Unit price</span>
          <span class="text-right">Tax %</span>
          <span aria-hidden="true"></span>
        </div>
        <div class="space-y-2" data-lines-body></div>
        <button type="button" class="btn btn-ghost" data-add-line>
          <Icon name="arrow-right" size={15} /> Add line item
        </button>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="text-xs font-medium" for={`${p}-discount`}>Discount (%)</label>
          <input
            class="field mt-1"
            id={`${p}-discount`}
            data-discount
            type="number"
            min="0"
            max="100"
            step="any"
            value="0"
          />
        </div>
        <div>
          <label class="text-xs font-medium" for={`${p}-logo`}>Logo (optional)</label>
          <input
            class="field mt-1"
            id={`${p}-logo`}
            data-logo
            type="file"
            accept="image/png,image/jpeg"
          />
          <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" data-logo-preview>
            No logo selected.
          </p>
        </div>
      </div>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label class="text-xs font-medium" for={`${p}-notes`}>Notes</label>
          <textarea class="field mt-1" id={`${p}-notes`} data-notes rows="3"></textarea>
        </div>
        <div>
          <label class="text-xs font-medium" for={`${p}-terms`}>Terms</label>
          <textarea class="field mt-1" id={`${p}-terms`} data-terms rows="3"></textarea>
        </div>
      </div>
    </div>

    <aside class="space-y-4">
      <div class="rounded-lg border p-4" data-totals aria-live="polite"></div>

      <div class="flex flex-col gap-2">
        <button type="button" class="btn btn-primary" data-generate>
          <Icon name="file-text" size={16} /> Generate PDF
        </button>
        <div class="flex gap-2">
          <button type="button" class="btn btn-subtle flex-1" data-save-draft>Save draft</button>
          <button type="button" class="btn btn-subtle flex-1" data-load-draft>Load draft</button>
          <button type="button" class="btn btn-ghost" data-clear-draft>Clear</button>
        </div>
        <p
          class="text-xs text-[rgb(var(--text-muted))]"
          data-draft-status
          role="status"
          aria-live="polite"
        >
          Drafts stay on this device.
        </p>
      </div>

      <div
        class="mt-4 rounded-lg border px-3 py-2 text-sm"
        style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
        role="alert"
        data-error
        hidden
      >
      </div>

      <div class="mt-4" hidden data-result-wrap>
        <div class="mb-2 flex items-center justify-between">
          <span class="text-sm font-semibold text-[rgb(var(--text))]">Result</span>
        </div>
        <div data-report></div>
      </div>
    </aside>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Building an invoice needs JavaScript. The PDF is created entirely on your device.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-invoice-generator-workbench]').forEach((root) => {
    // Loaded on demand: the invoice panel is only used by the invoice generator.
    void import('./invoice-generator-panel')
      .then(({ mountInvoiceGeneratorPanel }) => mountInvoiceGeneratorPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The invoice panel could not be loaded in this browser.';
        }
      });
  });
</script>
