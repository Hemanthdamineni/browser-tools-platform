---
/**
 * The data URI panel: text in, files in, data: URI out.
 *
 * The merged `data-uri` tool takes text *and* files, which the generic
 * workbench cannot express, so the tool opts into this panel via
 * `meta.panel = 'data-uri'`.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '../workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const options = meta.options ?? [];
const examples = meta.examples ?? [];
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-data-uri-workbench
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  {
    examples.length > 0 && (
      <div class="mb-4 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((ex, i) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={i}
            data-example-payload={JSON.stringify({
              input: ex.input ?? '',
              options: ex.options ?? {},
            })}
          >
            {ex.title}
          </button>
        ))}
      </div>
    )
  }

  <div class="mb-4" data-text-input>
    <div class="mb-1.5 flex items-center justify-between">
      <label for={`${p}-input`} class="text-sm font-medium"> Text </label>
      <div class="flex gap-1.5">
        <button type="button" class="btn btn-subtle btn-sm" data-paste>Paste</button>
        <button type="button" class="btn btn-subtle btn-sm" data-clear>Clear</button>
      </div>
    </div>
    <textarea
      id={`${p}-input`}
      class="field"
      rows="6"
      spellcheck="false"
      autocapitalize="off"
      autocomplete="off"
      data-input
      placeholder="Type or paste here…"></textarea>
    <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" data-input-hint>
      The text never leaves this tab.
    </p>
  </div>

  <div class="mb-4" data-file-input hidden>
    <div
      class="drop-zone mt-1 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
      data-drop
      role="button"
      tabindex="0"
      aria-label="Choose a file or drop it here"
    >
      <Icon name="file-text" size={26} class="opacity-60" />
      <p class="text-sm font-medium">
        <span data-file-label>Choose a file</span>, or <span class="link">browse</span>
      </p>
      <p class="text-xs text-[rgb(var(--text-muted))]">The file never leaves your device.</p>
    </div>
    <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>
  </div>

  {
    options.length > 0 && (
      <details class="mb-4 rounded-lg border" open>
        <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
        <div class="border-t p-3">
          <OptionsFields options={options} idPrefix={p} />
        </div>
      </details>
    )
  }

  <div class="flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run>
      <Icon name="zap" size={16} />
      <span data-run-label>Run</span>
    </button>
    <button type="button" class="btn btn-subtle btn-sm" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-subtle btn-sm" data-reset>Reset</button>
    <span
      class="ml-auto text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      role="status"
      aria-live="polite"></span>
  </div>

  <div class="mt-4" hidden data-progress-wrap>
    <div class="h-1.5 w-full overflow-hidden rounded-full bg-[rgb(var(--bg-inset))]">
      <div class="h-full w-0 bg-[rgb(var(--accent))] transition-[width]" data-progress-bar></div>
    </div>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]">Output</span>
      <div class="flex gap-1.5">
        <button type="button" class="btn btn-subtle btn-sm" data-copy>
          <Icon name="copy" size={14} /> Copy
        </button>
        <button type="button" class="btn btn-subtle btn-sm" data-download>
          <Icon name="download" size={14} /> Download
        </button>
      </div>
    </div>
    <div data-output></div>
    <ul class="mt-3 space-y-2" data-outputs></ul>
    <div
      class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[rgb(var(--text-muted))]"
      data-stats
    >
    </div>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-data-uri-workbench]').forEach((root) => {
    // Loaded on demand: the panel is only used by the data URI converter.
    void import('./data-uri')
      .then(({ mountDataUriPanel }) => mountDataUriPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The data URI panel could not be loaded in this browser.';
        }
      });
  });
</script>
