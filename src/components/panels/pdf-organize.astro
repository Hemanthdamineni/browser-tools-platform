---
/**
 * The PDF organiser workbench: choose a PDF, then arrange its pages on a
 * thumbnail grid — drag them into a new order, turn them, drop the ones you do
 * not need and slip in a blank sheet. The new PDF is assembled in the generic
 * Web Worker (`pdf-organize.tool.ts`), so a large document never freezes the tab.
 *
 * The generic file workbench cannot express this flow (a thumbnail grid with
 * drag-and-drop, per-page controls and a live page plan), so the tool opts
 * into this panel via `meta.panel = 'pdf-organize'`.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-pdf-organize-workbench
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose the PDF</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a PDF file or drop it here"
  >
    <Icon name="file-text" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a PDF here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">The file never leaves your device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Arrange the pages</h2>
  <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" id={`${p}-grid-hint`} data-grid-hint>
    Drag a page to move it, or focus a page and use the left and right arrow keys. Every page
    also has Move, Rotate and Delete buttons.
  </p>

  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div>
      <label class="text-xs font-medium" for={`${p}-blank-size`}>Blank page size</label>
      <select class="field mt-1 !w-52" id={`${p}-blank-size`} data-blank-size>
        <option value="a4" selected>A4 portrait</option>
        <option value="a4-landscape">A4 landscape</option>
        <option value="letter">Letter portrait</option>
        <option value="letter-landscape">Letter landscape</option>
      </select>
    </div>
    <button type="button" class="btn btn-subtle" data-insert-blank disabled>
      <Icon name="file-text" size={15} /> Insert blank page
    </button>
    <button type="button" class="btn btn-ghost" data-reset-order disabled>Reset order</button>
  </div>

  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-order-status
    role="status"
    aria-live="polite"
  >
  </p>

  <ul
    class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4"
    data-grid
    aria-label="PDF pages in the new order"
    aria-describedby={`${p}-grid-hint`}
  >
  </ul>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Save organised PDF
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Arranging pages needs JavaScript. You can still download the PDF and organise it in a
      desktop application.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-pdf-organize-workbench]').forEach((root) => {
    // Loaded on demand: the organiser panel is only used by the PDF organiser.
    void import('./pdf-organize-panel')
      .then(({ mountPdfOrganizePanel }) => mountPdfOrganizePanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The organiser panel could not be loaded in this browser.';
        }
      });
  });
</script>
