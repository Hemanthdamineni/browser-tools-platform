---
/**
 * The HTML playground panel: three source panes (HTML / CSS / JS), a live
 * preview in a sandboxed iframe, and a Download that stitches the three
 * parts into one self-contained .html file.
 *
 * The generic workbench cannot express a live preview, so the tool opts into
 * this panel via `meta.panel = 'html-playground'`. All the real logic lives in
 * `html-playground-panel.ts`; this component only renders the shell.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '../workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';
import { DEFAULT_PARTS } from '@/components/panels/html-playground-panel';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
const options = meta.options ?? [];
const examples = meta.examples ?? [];
const headingId = `${p}-heading`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-html-playground-workbench
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2
      id={headingId}
      class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]"
    >
      <Icon name="braces" size={18} /> HTML / CSS / JS
    </h2>
    <span class="chip">Stable</span>
  </div>

  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Type in the three panes and the preview updates as you go. The preview runs in a sandboxed
    iframe without same-origin access, so your code can never touch this site — and Download
    stitches the three parts into one self-contained .html file.
  </p>

  {
    examples.length > 0 && (
      <div class="mb-4 mt-3 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((ex, i) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={i}
            data-example-payload={JSON.stringify({
              input: ex.input ?? '',
              options: ex.options ?? {},
            })}
          >
            {ex.title}
          </button>
        ))}
      </div>
    )
  }

  <div class="mt-2 grid gap-3 lg:grid-cols-2">
    <!-- The three source panes -->
    <div class="flex min-w-0 flex-col gap-3">
      <div>
        <label class="text-xs font-medium" for={`${p}-html`}>HTML</label>
        <textarea
          id={`${p}-html`}
          class="field mt-1 h-40 w-full resize-y font-mono text-sm"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          data-pane="html">{DEFAULT_PARTS.html}</textarea
        >
      </div>
      <div>
        <label class="text-xs font-medium" for={`${p}-css`}>CSS</label>
        <textarea
          id={`${p}-css`}
          class="field mt-1 h-32 w-full resize-y font-mono text-sm"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          data-pane="css">{DEFAULT_PARTS.css}</textarea
        >
      </div>
      <div>
        <label class="text-xs font-medium" for={`${p}-js`}>JavaScript</label>
        <textarea
          id={`${p}-js`}
          class="field mt-1 h-32 w-full resize-y font-mono text-sm"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          data-pane="js">{DEFAULT_PARTS.js}</textarea
        >
      </div>
    </div>

    <!-- The sandboxed preview -->
    <div class="flex min-w-0 flex-col">
      <div class="mb-1.5 flex items-center justify-between gap-2">
        <span class="text-sm font-medium text-[rgb(var(--text))]">Preview</span>
        <span class="text-xs text-[rgb(var(--text-muted))]">sandboxed — can’t reach this site</span>
      </div>
      <iframe
        class="h-[26rem] w-full rounded-lg border bg-white"
        data-preview
        sandbox="allow-scripts"
        title="Live preview of your HTML, CSS and JavaScript"
        referrerpolicy="no-referrer"></iframe>
    </div>
  </div>

  {
    options.length > 0 && (
      <details class="mb-3 mt-4 rounded-lg border">
        <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
        <div class="border-t p-3">
          <OptionsFields options={options} idPrefix={p} />
        </div>
      </details>
    )
  }

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-download>
      <Icon name="download" size={16} /> Download .html
    </button>
    <button type="button" class="btn btn-subtle" data-reset>
      <Icon name="arrow-left-right" size={15} /> Reset
    </button>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      The live preview needs JavaScript. You can still download the default starter as an .html file
      if scripting is off — but the editor won’t re-render.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-html-playground-workbench]').forEach((root) => {
    // Loaded on demand: the playground panel is only used by this tool.
    void import('./html-playground-panel')
      .then(({ mountHtmlPlaygroundPanel }) => mountHtmlPlaygroundPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The playground panel could not be loaded in this browser.';
        }
      });
  });
</script>
