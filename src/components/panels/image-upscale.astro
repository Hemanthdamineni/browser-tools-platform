---
/**
 * The "Upscale Image" panel.
 *
 * The generic file workbench cannot show a live preview that updates as the
 * interpolation / sharpening sliders move, so this tool opts into its own panel
 * via `meta.panel = 'image-upscale'`. The panel owns the preview (computed on
 * the main thread at a reduced resolution so sliders stay smooth) and hands the
 * full-resolution export to the tool worker.
 *
 * The root deliberately carries no `data-file-workbench`: `FileWorkbench.astro`'s
 * script binds to every `[data-file-workbench]` root and would attach a second
 * drop zone, a second run handler and a `[data-download-all]` lookup this panel
 * does not have. Panel tools are marked by `PanelWorkbench` with
 * `data-panel-workbench` instead.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '@/components/workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
const options = meta.options ?? [];
const examples = meta.examples ?? [];
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-image-upscale-panel
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose an image</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose an image file or drop it here"
  >
    <Icon name="image" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a PNG, JPEG or WebP here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">The image never leaves your device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Set the upscale</h2>
  {
    examples.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((example, index) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={index}
            data-example-options={JSON.stringify(example.options ?? {})}
          >
            {example.title}
          </button>
        ))}
      </div>
    )
  }
  <div class="mt-3">
    <OptionsFields options={options} idPrefix={p} />
  </div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Preview</h2>
  <div class="relative mt-3 overflow-hidden rounded-lg border">
    <canvas
      class="block w-full"
      width="16"
      height="9"
      role="img"
      aria-label="Preview of the upscaled image"
      data-preview-canvas
    ></canvas>
  </div>
  <p class="mt-2 text-xs text-[rgb(var(--text-muted))]" data-preview-status role="status" aria-live="polite">
    Choose an image to see it here.
  </p>
  <p class="mt-1 text-xs leading-relaxed text-[rgb(var(--text-muted))]">
    This is algorithmic upscaling — Lanczos3 / bicubic / nearest interpolation
    plus an optional unsharp mask. It is not AI super-resolution, so it cannot
    invent detail that the photo does not contain.
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Upscale
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out motion-reduce:transition-none"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Upscaling an image needs JavaScript. Nothing is ever uploaded.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-image-upscale-panel]').forEach((panel) => {
    void import('./image-upscale-panel')
      .then(({ mountImageUpscalePanel }) => mountImageUpscalePanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The upscale panel could not be loaded in this browser.';
        }
      });
  });
</script>