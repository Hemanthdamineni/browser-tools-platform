---
// Spectrogram panel component
---

<script is:inline>
  import { onMount } from 'astro/runtime/client';

  // State
  let audioContext: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let mediaStream: MediaStream | null = null;
  let animationId: number | null = null;
  let isRunning = false;
  let currentMode: 'file' | 'mic' = 'file';
  let fileData: SpectrogramData | null = null;

  // UI elements
  const modeFile = document.getElementById('spec-mode-file') as HTMLInputElement;
  const modeMic = document.getElementById('spec-mode-mic') as HTMLInputElement;
  const fileSection = document.getElementById('spec-file-section') as HTMLDivElement;
  const micSection = document.getElementById('spec-mic-section') as HTMLDivElement;
  const fileInput = document.getElementById('spec-file-input') as HTMLInputElement;
  const deviceSelect = document.getElementById('spec-device') as HTMLSelectElement;
  const fftSizeSelect = document.getElementById('spec-fft-size') as HTMLSelectElement;
  const windowSelect = document.getElementById('spec-window') as HTMLSelectElement;
  const overlapSelect = document.getElementById('spec-overlap') as HTMLSelectElement;
  const colorMapSelect = document.getElementById('spec-colormap') as HTMLSelectElement;
  const minDbInput = document.getElementById('spec-min-db') as HTMLInputElement;
  const maxDbInput = document.getElementById('spec-max-db') as HTMLInputElement;
  const freqMinInput = document.getElementById('spec-freq-min') as HTMLInputElement;
  const freqMaxInput = document.getElementById('spec-freq-max') as HTMLInputElement;
  const logScaleInput = document.getElementById('spec-log-scale') as HTMLInputElement;
  const generateBtn = document.getElementById('spec-generate') as HTMLButtonElement;
  const startMicBtn = document.getElementById('spec-start-mic') as HTMLButtonElement;
  const stopMicBtn = document.getElementById('spec-stop-mic') as HTMLButtonElement;
  const exportBtn = document.getElementById('spec-export') as HTMLButtonElement;
  const canvas = document.getElementById('spec-canvas') as HTMLCanvasElement;
  const statusEl = document.getElementById('spec-status') as HTMLDivElement;

  // Canvas rendering state
  let renderWidth = 0;
  let renderHeight = 0;

  // Color maps (mirrored from core)
  const COLOR_MAPS: Record<string, (t: number) => [number, number, number]> = {
    viridis: (t) => { t = Math.max(0, Math.min(1, t)); return [Math.round((0.23 + 0.58 * t + 0.24 * t * t) * 255), Math.round((0.15 + 0.72 * t - 0.52 * t * t) * 255), Math.round((0.57 - 0.77 * t + 0.32 * t * t) * 255)]; },
    inferno: (t) => { t = Math.max(0, Math.min(1, t)); return [Math.round((0.002 + 1.8 * t - 1.2 * t * t + 0.4 * t * t * t) * 255), Math.round((0.003 - 0.5 * t + 2.5 * t * t - 2.0 * t * t * t) * 255), Math.round((0.54 + 0.6 * t - 1.5 * t * t + 1.1 * t * t * t) * 255)]; },
    plasma: (t) => { t = Math.max(0, Math.min(1, t)); return [Math.round((0.05 + 1.5 * t - 1.2 * t * t + 0.5 * t * t * t) * 255), Math.round((0.02 + 0.8 * t - 2.0 * t * t + 1.8 * t * t * t) * 255), Math.round((0.45 + 0.5 * t - 1.5 * t * t + 1.2 * t * t * t) * 255)]; },
    magma: (t) => { t = Math.max(0, Math.min(1, t)); return [Math.round((0.001 + 2.0 * t - 1.5 * t * t + 0.5 * t * t * t) * 255), Math.round((0.002 + 0.5 * t - 1.8 * t * t + 1.5 * t * t * t) * 255), Math.round((0.5 + 0.8 * t - 1.2 * t * t + 0.8 * t * t * t) * 255)]; },
    jet: (t) => { t = Math.max(0, Math.min(1, t)); let r, g, b; if (t < 0.125) { r = 0; g = 0; b = 0.5 + 4 * t; } else if (t < 0.375) { r = 0; g = 4 * (t - 0.125); b = 1; } else if (t < 0.625) { r = 4 * (t - 0.375); g = 1; b = 1 - 4 * (t - 0.375); } else if (t < 0.875) { r = 1; g = 1 - 4 * (t - 0.625); b = 0; } else { r = 1 - 4 * (t - 0.875); g = 0; b = 0; } return [Math.round(r * 255), Math.round(g * 255), Math.round(b * 255)]; },
    grayscale: (t) => { t = Math.max(0, Math.min(1, t)); const v = Math.round(t * 255); return [v, v, v]; },
  };

  function getOptions(): SpectrogramOptions {
    return {
      fftSize: Number(fftSizeSelect.value),
      windowType: windowSelect.value as SpectrogramOptions['windowType'],
      overlap: Number(overlapSelect.value) / 100,
      colorMap: colorMapSelect.value as SpectrogramOptions['colorMap'],
      minDb: Number(minDbInput.value),
      maxDb: Number(maxDbInput.value),
      freqMin: Number(freqMinInput.value),
      freqMax: Number(freqMaxInput.value),
      logScale: logScaleInput.checked,
    };
  }

  interface SpectrogramOptions {
    fftSize: number;
    windowType: 'hann' | 'hamming' | 'blackman' | 'rectangular';
    overlap: number;
    colorMap: 'viridis' | 'inferno' | 'plasma' | 'magma' | 'jet' | 'grayscale';
    minDb: number;
    maxDb: number;
    freqMin: number;
    freqMax: number;
    logScale: boolean;
  }

  interface SpectrogramData {
    magnitudeDb: number[][];
    frequencies: number[];
    times: number[];
    sampleRate: number;
    fftSize: number;
    hopSize: number;
  }

  function getWindow(type: SpectrogramOptions['windowType'], size: number): Float32Array {
    const window = new Float32Array(size);
    switch (type) {
      case 'hann':
        for (let i = 0; i < size; i++) window[i] = 0.5 * (1 - Math.cos((2 * Math.PI * i) / (size - 1))); break;
      case 'hamming':
        for (let i = 0; i < size; i++) window[i] = 0.54 - 0.46 * Math.cos((2 * Math.PI * i) / (size - 1)); break;
      case 'blackman':
        for (let i = 0; i < size; i++) { const a0 = 0.42, a1 = 0.5, a2 = 0.08; window[i] = a0 - a1 * Math.cos((2 * Math.PI * i) / (size - 1)) + a2 * Math.cos((4 * Math.PI * i) / (size - 1)); } break;
      case 'rectangular': window.fill(1); break;
    }
    return window;
  }

  function rfft(input: Float32Array): { real: Float32Array; imag: Float32Array } {
    const n = input.length;
    const real = new Float32Array(n / 2 + 1);
    const imag = new Float32Array(n / 2 + 1);
    for (let k = 0; k <= n / 2; k++) {
      let re = 0, im = 0;
      for (let t = 0; t < n; t++) {
        const angle = -2 * Math.PI * k * t / n;
        re += input[t] * Math.cos(angle);
        im += input[t] * Math.sin(angle);
      }
      real[k] = re; imag[k] = im;
    }
    return { real, imag };
  }

  function computeMagnitude(real: Float32Array, imag: Float32Array): Float32Array {
    const n = real.length; const mag = new Float32Array(n);
    for (let i = 0; i < n; i++) mag[i] = Math.sqrt(real[i] * real[i] + imag[i] * imag[i]);
    return mag;
  }

  function magnitudeToDb(magnitude: Float32Array): Float32Array {
    const db = new Float32Array(magnitude.length);
    for (let i = 0; i < magnitude.length; i++) db[i] = magnitude[i] > 0 ? 20 * Math.log10(magnitude[i]) : -Infinity;
    return db;
  }

  async function generateFromFile(file: File): Promise<SpectrogramData> {
    const arrayBuffer = await file.arrayBuffer();
    const audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
    const audioBuffer = await audioContext.decodeAudioData(arrayBuffer.slice(0));
    audioContext.close();

    const channels: Float32Array[] = [];
    for (let c = 0; c < audioBuffer.numberOfChannels; c++) {
      channels.push(audioBuffer.getChannelData(c).slice(0));
    }

    return computeSpectrogram(channels, audioBuffer.sampleRate, getOptions());
  }

  function computeSpectrogram(channels: Float32Array[], sampleRate: number, options: SpectrogramOptions): SpectrogramData {
    const len = Math.max(...channels.map(c => c.length));
    const mono = new Float32Array(len);
    for (let i = 0; i < len; i++) {
      let sum = 0;
      for (const ch of channels) sum += ch[i] ?? 0;
      mono[i] = sum / channels.length;
    }

    const fftSize = options.fftSize;
    const hopSize = Math.floor(fftSize * (1 - options.overlap));
    const window = getWindow(options.windowType, fftSize);
    const numFrames = Math.floor((len - fftSize) / hopSize) + 1;

    if (numFrames <= 0) throw new Error('Audio too short for selected FFT size.');

    const magnitudeDb: number[][] = [];
    const times: number[] = [];
    const frequencies: number[] = [];

    for (let k = 0; k <= fftSize / 2; k++) {
      frequencies.push((k * sampleRate) / fftSize);
    }

    const freqMin = options.freqMin;
    const freqMax = Math.min(options.freqMax, sampleRate / 2);
    const validBins = frequencies.map((f, i) => f >= freqMin && f <= freqMax ? i : -1).filter(i => i >= 0);
    const filteredFrequencies = validBins.map(i => frequencies[i]);

    for (let frame = 0; frame < numFrames; frame++) {
      const offset = frame * hopSize;
      const frameData = new Float32Array(fftSize);
      frameData.set(mono.subarray(offset, offset + fftSize));

      for (let i = 0; i < fftSize; i++) frameData[i] *= window[i];

      const { real, imag } = rfft(frameData);
      const mag = computeMagnitude(real, imag);
      const db = magnitudeToDb(mag);

      const frameDb = validBins.map(i => db[i]);
      magnitudeDb.push(frameDb);
      times.push((offset + fftSize / 2) / sampleRate);
    }

    return { magnitudeDb, frequencies: filteredFrequencies, times, sampleRate, fftSize, hopSize };
  }

  function renderSpectrogram(data: SpectrogramData, options: SpectrogramOptions) {
    const ctx = canvas.getContext('2d')!;
    const dpr = window.devicePixelRatio || 1;
    const containerWidth = canvas.parentElement?.clientWidth || 800;
    renderWidth = Math.min(1600, containerWidth) * dpr;
    renderHeight = 600 * dpr;
    canvas.width = renderWidth;
    canvas.height = renderHeight;
    canvas.style.width = `${renderWidth / dpr}px`;
    canvas.style.height = `${renderHeight / dpr}px`;

    const { magnitudeDb, frequencies, times } = data;
    const numFrames = times.length;
    const numBins = frequencies.length;

    if (numFrames === 0 || numBins === 0) return;

    const colorMap = COLOR_MAPS[options.colorMap];
    const minDb = options.minDb;
    const maxDb = options.maxDb;
    const dbRange = maxDb - minDb;

    const imgData = ctx.createImageData(numFrames, numBins);
    const pixels = imgData.data;

    for (let y = 0; y < numBins; y++) {
      for (let x = 0; x < numFrames; x++) {
        const db = magnitudeDb[x][y];
        let t = 0;
        if (Number.isFinite(db)) t = Math.max(0, Math.min(1, (db - minDb) / dbRange));
        const [r, g, b] = colorMap(t);
        const idx = (y * numFrames + x) * 4;
        pixels[idx] = r; pixels[idx + 1] = g; pixels[idx + 2] = b; pixels[idx + 3] = 255;
      }
    }

    ctx.imageSmoothingEnabled = false;
    ctx.putImageData(imgData, 0, 0);
    ctx.scale(renderWidth / numFrames, renderHeight / numBins);
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    drawAxes(ctx, renderWidth, renderHeight, data, options);
  }

  function drawAxes(ctx: CanvasRenderingContext2D, width: number, height: number, data: SpectrogramData, options: SpectrogramOptions) {
    const padding = { top: 30, right: 80, bottom: 50, left: 70 };
    const plotWidth = width - padding.left - padding.right;
    const plotHeight = height - padding.top - padding.bottom;

    ctx.fillStyle = '#e2e8f0';
    ctx.font = '14px system-ui, sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('Spectrogram', width / 2, padding.top / 2);

    // Y-axis label
    ctx.save();
    ctx.translate(padding.left, padding.top + plotHeight / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText('Frequency (Hz)', 0, -50);
    ctx.restore();

    // X-axis label
    ctx.fillText('Time (s)', width / 2, height - 10);

    // Y-axis ticks
    const freqTicks = options.logScale
      ? [20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000].filter(f => f >= options.freqMin && f <= options.freqMax)
      : generateLinearTicks(options.freqMin, options.freqMax, 6);

    ctx.textAlign = 'right';
    ctx.textBaseline = 'middle';
    ctx.font = '11px system-ui, sans-serif';
    for (const f of freqTicks) {
      let y: number;
      if (options.logScale) {
        const logMin = Math.log10(options.freqMin);
        const logMax = Math.log10(options.freqMax);
        const logF = Math.log10(f);
        y = padding.top + plotHeight * (1 - (logF - logMin) / (logMax - logMin));
      } else {
        y = padding.top + plotHeight * (1 - (f - options.freqMin) / (options.freqMax - options.freqMin));
      }
      y = Math.max(padding.top, Math.min(padding.top + plotHeight, y));
      ctx.fillText(f >= 1000 ? `${(f / 1000).toFixed(1)}k` : `${f}`, padding.left - 10, y);
      ctx.strokeStyle = 'rgba(255,255,255,0.1)';
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(padding.left + plotWidth, y);
      ctx.stroke();
    }

    // X-axis ticks
    const maxTime = data.times[data.times.length - 1] || 1;
    const timeTicks = generateLinearTicks(0, maxTime, 6);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'top';
    for (const t of timeTicks) {
      const x = padding.left + plotWidth * (t / maxTime);
      ctx.fillText(t.toFixed(1), x, padding.top + plotHeight + 5);
      ctx.strokeStyle = 'rgba(255,255,255,0.1)';
      ctx.beginPath();
      ctx.moveTo(x, padding.top);
      ctx.lineTo(x, padding.top + plotHeight);
      ctx.stroke();
    }

    // Color bar
    drawColorBar(ctx, width, height, padding, options);
  }

  function generateLinearTicks(min: number, max: number, count: number): number[] {
    const ticks: number[] = []; const step = (max - min) / (count - 1);
    for (let i = 0; i < count; i++) ticks.push(min + i * step);
    return ticks;
  }

  function drawColorBar(ctx: CanvasRenderingContext2D, width: number, height: number, padding: { top: number; right: number; bottom: number; left: number }, options: SpectrogramOptions) {
    const barWidth = 20;
    const barHeight = height - padding.top - padding.bottom;
    const barX = width - padding.right - barWidth;
    const barY = padding.top;

    const colorMap = COLOR_MAPS[options.colorMap];
    const gradient = ctx.createLinearGradient(0, barY + barHeight, 0, barY);
    for (let i = 0; i <= 100; i++) {
      const t = i / 100;
      const [r, g, b] = colorMap(t);
      gradient.addColorStop(t, `rgb(${r},${g},${b})`);
    }

    ctx.fillStyle = gradient;
    ctx.fillRect(barX, barY, barWidth, barHeight);
    ctx.strokeStyle = '#64748b';
    ctx.strokeRect(barX, barY, barWidth, barHeight);

    ctx.fillStyle = '#94a3b8';
    ctx.font = '10px system-ui, sans-serif';
    ctx.textAlign = 'left';
    ctx.textBaseline = 'middle';
    ctx.fillText(`${options.maxDb} dB`, barX + barWidth + 5, barY);
    ctx.textBaseline = 'middle';
    ctx.fillText(`${options.minDb} dB`, barX + barWidth + 5, barY + barHeight);
  }

  async function populateDevices() {
    try {
      const devices = await navigator.mediaDevices.enumerateDevices();
      const audioInputs = devices.filter(d => d.kind === 'audioinput');
      deviceSelect.innerHTML = '';
      audioInputs.forEach((device, i) => {
        const opt = document.createElement('option');
        opt.value = device.deviceId;
        opt.textContent = device.label || `Microphone ${i + 1}`;
        deviceSelect.appendChild(opt);
      });
      if (audioInputs.length === 0) {
        const opt = document.createElement('option');
        opt.value = ''; opt.textContent = 'No microphones found'; opt.disabled = true;
        deviceSelect.appendChild(opt);
        startMicBtn.disabled = true;
      }
    } catch (e) { console.error('Failed to enumerate devices:', e); }
  }

  // Mode switching
  function switchMode(mode: 'file' | 'mic') {
    currentMode = mode;
    modeFile.checked = mode === 'file';
    modeMic.checked = mode === 'mic';
    fileSection.style.display = mode === 'file' ? 'block' : 'none';
    micSection.style.display = mode === 'mic' ? 'block' : 'none';
    stopMicBtn.disabled = true;
    generateBtn.disabled = mode === 'file' && !fileInput.files?.length;
    if (mode === 'mic' && isRunning) stopMicBtn.disabled = false;
  }

  // File handling
  fileInput.addEventListener('change', () => {
    generateBtn.disabled = !fileInput.files?.length;
  });

  generateBtn.addEventListener('click', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    try {
      statusEl.textContent = 'Processing file...';
      statusEl.className = 'spec-status info';
      generateBtn.disabled = true;
      exportBtn.disabled = true;

      fileData = await generateFromFile(file);
      renderSpectrogram(fileData, getOptions());

      statusEl.textContent = 'Spectrogram generated';
      statusEl.className = 'spec-status success';
      exportBtn.disabled = false;
    } catch (e) {
      statusEl.textContent = `Error: ${e instanceof Error ? e.message : 'Unknown'}`;
      statusEl.className = 'spec-status error';
    } finally {
      generateBtn.disabled = false;
    }
  });

  // Microphone handling
  async function startMic() {
    if (isRunning) return;
    try {
      statusEl.textContent = 'Starting microphone...';
      statusEl.className = 'spec-status info';

      const deviceId = deviceSelect.value || undefined;
      const constraints: MediaStreamConstraints = {
        audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, deviceId: deviceId ? { exact: deviceId } : undefined },
        video: false,
      };

      mediaStream = await navigator.mediaDevices.getUserMedia(constraints);

      audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
      analyser = audioContext.createAnalyser();
      analyser.fftSize = Number(fftSizeSelect.value);
      analyser.smoothingTimeConstant = 0;

      const source = audioContext.createMediaStreamSource(mediaStream);
      source.connect(analyser);

      isRunning = true;
      startMicBtn.disabled = true;
      stopMicBtn.disabled = false;
      deviceSelect.disabled = true;
      exportBtn.disabled = true;
      statusEl.textContent = 'Recording... click Stop to generate spectrogram';
      statusEl.className = 'spec-status active';

      // Collect time-domain data for offline processing
      const chunks: Float32Array[] = [];
      let totalLength = 0;

      function collectAudio() {
        if (!isRunning || !analyser) return;
        const bufferLength = analyser.frequencyBinCount;
        const timeData = new Float32Array(bufferLength);
        analyser.getFloatTimeDomainData(timeData);
        chunks.push(timeData.slice(0));
        totalLength += bufferLength;
        animationId = requestAnimationFrame(collectAudio);
      }

      collectAudio();
    } catch (e) {
      if (e instanceof DOMException && e.name === 'NotAllowedError') {
        statusEl.textContent = 'Microphone access denied.';
      } else if (e instanceof DOMException && e.name === 'NotFoundError') {
        statusEl.textContent = 'No microphone found.';
      } else {
        statusEl.textContent = `Error: ${e instanceof Error ? e.message : 'Unknown'}`;
      }
      statusEl.className = 'spec-status error';
    }
  }

  function stopMic() {
    isRunning = false;
    if (animationId) { cancelAnimationFrame(animationId); animationId = null; }

    if (mediaStream) { mediaStream.getTracks().forEach(t => t.stop()); mediaStream = null; }
    if (audioContext) { audioContext.close(); audioContext = null; }
    analyser = null;

    startMicBtn.disabled = false;
    stopMicBtn.disabled = true;
    deviceSelect.disabled = false;

    if (chunks.length === 0) {
      statusEl.textContent = 'No audio recorded';
      statusEl.className = 'spec-status error';
      return;
    }

    // Combine chunks and compute spectrogram
    const combined = new Float32Array(totalLength);
    let offset = 0;
    for (const chunk of chunks) { combined.set(chunk, offset); offset += chunk.length; }
    chunks.length = 0;

    try {
      statusEl.textContent = 'Computing spectrogram...';
      statusEl.className = 'spec-status info';

      const sampleRate = audioContext?.sampleRate || 44100;
      fileData = computeSpectrogram([combined], sampleRate, getOptions());
      renderSpectrogram(fileData, getOptions());

      statusEl.textContent = 'Spectrogram generated';
      statusEl.className = 'spec-status success';
      exportBtn.disabled = false;
    } catch (e) {
      statusEl.textContent = `Error: ${e instanceof Error ? e.message : 'Unknown'}`;
      statusEl.className = 'spec-status error';
    }
  }

  let chunks: Float32Array[] = [];
  let totalLength = 0;

  startMicBtn.addEventListener('click', startMic);
  stopMicBtn.addEventListener('click', stopMic);

  // Export
  exportBtn.addEventListener('click', async () => {
    if (!fileData) return;
    try {
      exportBtn.disabled = true;
      exportBtn.textContent = 'Exporting...';

      // Create high-res canvas for export
      const exportCanvas = document.createElement('canvas');
      const exportCtx = exportCanvas.getContext('2d')!;
      const exportWidth = 2400;
      const exportHeight = 1200;
      exportCanvas.width = exportWidth;
      exportCanvas.height = exportHeight;

      // Re-render at high res
      const { magnitudeDb, frequencies, times } = fileData;
      const options = getOptions();
      const colorMap = COLOR_MAPS[options.colorMap];
      const minDb = options.minDb;
      const maxDb = options.maxDb;
      const dbRange = maxDb - minDb;
      const numFrames = times.length;
      const numBins = frequencies.length;

      const imgData = exportCtx.createImageData(numFrames, numBins);
      const pixels = imgData.data;
      for (let y = 0; y < numBins; y++) {
        for (let x = 0; x < numFrames; x++) {
          const db = magnitudeDb[x][y];
          let t = 0;
          if (Number.isFinite(db)) t = Math.max(0, Math.min(1, (db - minDb) / dbRange));
          const [r, g, b] = colorMap(t);
          const idx = (y * numFrames + x) * 4;
          pixels[idx] = r; pixels[idx + 1] = g; pixels[idx + 2] = b; pixels[idx + 3] = 255;
        }
      }

      exportCtx.imageSmoothingEnabled = false;
      exportCtx.putImageData(imgData, 0, 0);
      exportCtx.scale(exportWidth / numFrames, exportHeight / numBins);
      exportCtx.setTransform(1, 0, 0, 1, 0, 0);
      drawAxes(exportCtx, exportWidth, exportHeight, fileData, options);

      const blob = await new Promise<Blob>((resolve) => exportCanvas.toBlob((b) => resolve(b!), 'image/png'));
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `spectrogram-${Date.now()}.png`;
      a.click();
      URL.revokeObjectURL(url);

      exportBtn.textContent = 'Export PNG';
      exportBtn.disabled = false;
    } catch (e) {
      exportBtn.textContent = 'Export PNG';
      exportBtn.disabled = false;
      statusEl.textContent = `Export failed: ${e instanceof Error ? e.message : 'Unknown'}`;
      statusEl.className = 'spec-status error';
    }
  });

  // Parameter change re-renders if we have data
  [fftSizeSelect, windowSelect, overlapSelect, colorMapSelect, minDbInput, maxDbInput, freqMinInput, freqMaxInput, logScaleInput].forEach(el => {
    el.addEventListener('change', () => {
      if (fileData) renderSpectrogram(fileData, getOptions());
    });
  });

  // Mode radio buttons
  modeFile.addEventListener('change', () => switchMode('file'));
  modeMic.addEventListener('change', () => switchMode('mic'));

  // Device change
  navigator.mediaDevices?.addEventListener?.('devicechange', populateDevices);

  // Initialize
  populateDevices();
  switchMode('file');
</script>

<div class="spectrogram-panel">
  <div class="spec-header">
    <h2>Audio Spectrogram</h2>
    <p class="spec-desc">Visualize frequency content over time from file or microphone</p>
  </div>

  <div class="spec-mode-tabs">
    <label class="spec-mode-tab">
      <input type="radio" id="spec-mode-file" name="spec-mode" value="file" checked> File
    </label>
    <label class="spec-mode-tab">
