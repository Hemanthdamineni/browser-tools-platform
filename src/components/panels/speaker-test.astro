---
// Speaker Test panel component
---

<script is:inline>
  import { onMount } from 'astro/runtime/client';

  let audioContext: AudioContext | null = null;
  let masterGain: GainNode | null = null;
  let isPlaying = false;
  let currentSource: AudioBufferSourceNode | OscillatorNode | null = null;
  let sweepAnimationId: number | null = null;
  let sweepStartTime = 0;
  let sweepDuration = 10;
  let sweepType = 'logarithmic';

  // UI elements
  const volumeInput = document.getElementById('speaker-volume') as HTMLInputElement;
  const volumeValue = document.getElementById('speaker-volume-value') as HTMLSpanElement;
  const sweepDurationSelect = document.getElementById('speaker-sweep-duration') as HTMLSelectElement;
  const sweepTypeSelect = document.getElementById('speaker-sweep-type') as HTMLSelectElement;

  const btnLeft = document.getElementById('speaker-left') as HTMLButtonElement;
  const btnRight = document.getElementById('speaker-right') as HTMLButtonElement;
  const btnBoth = document.getElementById('speaker-both') as HTMLButtonElement;
  const btnSweep = document.getElementById('speaker-sweep') as HTMLButtonElement;
  const btnStop = document.getElementById('speaker-stop') as HTMLButtonElement;

  const statusEl = document.getElementById('speaker-status') as HTMLDivElement;
  const sweepProgress = document.getElementById('speaker-sweep-progress') as HTMLDivElement;
  const sweepProgressFill = document.getElementById('speaker-sweep-progress-fill') as HTMLDivElement;
  const sweepFreq = document.getElementById('speaker-sweep-freq') as HTMLDivElement;

  function ensureAudioContext() {
    if (!audioContext) {
      audioContext = new (window.AudioContext || (window as any).webkitAudioContext)();
      masterGain = audioContext.createGain();
      masterGain.connect(audioContext.destination);
      updateVolume();
    }
    // Resume if suspended (browser autoplay policy)
    if (audioContext.state === 'suspended') {
      audioContext.resume();
    }
  }

  function updateVolume() {
    if (masterGain) {
      masterGain.gain.value = Number(volumeInput.value) / 100;
    }
  }

  function setStatus(text: string, type: 'idle' | 'active' | 'error' | 'info' = 'idle') {
    statusEl.textContent = text;
    statusEl.className = `speaker-status ${type}`;
  }

  function playTone(frequency: number, duration: number, channel: 'left' | 'right' | 'both') {
    ensureAudioContext();
    if (!audioContext || !masterGain) return;

    // Stop any current playback
    stopAll();

    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();
    const panNode = audioContext.createStereoPanner();

    oscillator.type = 'sine';
    oscillator.frequency.value = frequency;
    gainNode.gain.value = 0.3; // Per-tone gain

    // Set panning
    if (channel === 'left') panNode.pan.value = -1;
    else if (channel === 'right') panNode.pan.value = 1;
    else panNode.pan.value = 0;

    oscillator.connect(gainNode);
    gainNode.connect(panNode);
    panNode.connect(masterGain);

    // Fade in/out to avoid clicks
    const now = audioContext.currentTime;
    gainNode.gain.setValueAtTime(0, now);
    gainNode.gain.linearRampToValueAtTime(0.3, now + 0.01);
    gainNode.gain.linearRampToValueAtTime(0, now + duration - 0.01);

    oscillator.start(now);
    oscillator.stop(now + duration);

    currentSource = oscillator;
    isPlaying = true;
    updateButtonStates();
  }

  function playNoise(duration: number, channel: 'left' | 'right' | 'both') {
    ensureAudioContext();
    if (!audioContext || !masterGain) return;

    stopAll();

    // Generate white noise buffer
    const bufferSize = audioContext.sampleRate * duration;
    const buffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) {
      data[i] = Math.random() * 2 - 1;
    }

    const source = audioContext.createBufferSource();
    const gainNode = audioContext.createGain();
    const panNode = audioContext.createStereoPanner();

    source.buffer = buffer;
    gainNode.gain.value = 0.1;
    if (channel === 'left') panNode.pan.value = -1;
    else if (channel === 'right') panNode.pan.value = 1;
    else panNode.pan.value = 0;

    source.connect(gainNode);
    gainNode.connect(panNode);
    panNode.connect(masterGain);

    source.start();
    source.stop(audioContext.currentTime + duration);

    currentSource = source;
    isPlaying = true;
    updateButtonStates();
  }

  function startSweep() {
    ensureAudioContext();
    if (!audioContext || !masterGain) return;

    stopAll();

    sweepDuration = Number(sweepDurationSelect.value);
    sweepType = sweepTypeSelect.value;

    const oscillator = audioContext.createOscillator();
    const gainNode = audioContext.createGain();

    oscillator.type = 'sine';
    gainNode.gain.value = 0.2;

    oscillator.connect(gainNode);
    gainNode.connect(masterGain);

    const startFreq = 20;
    const endFreq = 20000;
    const startTime = audioContext.currentTime;
    sweepStartTime = performance.now();

    if (sweepType === 'logarithmic') {
      // Logarithmic sweep: exponential frequency change
      oscillator.frequency.setValueAtTime(startFreq, startTime);
      oscillator.frequency.exponentialRampToValueAtTime(endFreq, startTime + sweepDuration);
    } else {
      // Linear sweep: constant Hz per second
      oscillator.frequency.setValueAtTime(startFreq, startTime);
      oscillator.frequency.linearRampToValueAtTime(endFreq, startTime + sweepDuration);
    }

    // Fade in/out
    gainNode.gain.setValueAtTime(0, startTime);
    gainNode.gain.linearRampToValueAtTime(0.2, startTime + 0.01);
    gainNode.gain.linearRampToValueAtTime(0, startTime + sweepDuration - 0.01);

    oscillator.start(startTime);
    oscillator.stop(startTime + sweepDuration);

    currentSource = oscillator;
    isPlaying = true;
    updateButtonStates();
    updateSweepUI(true);

    // Update sweep progress
    function updateSweep() {
      if (!isPlaying || !currentSource) return;
      const elapsed = (performance.now() - sweepStartTime) / 1000;
      const progress = Math.min(1, elapsed / sweepDuration);
      sweepProgressFill.style.width = `${progress * 100}%`;

      // Calculate current frequency for display
      let currentFreq: number;
      if (sweepType === 'logarithmic') {
        currentFreq = startFreq * Math.pow(endFreq / startFreq, progress);
      } else {
        currentFreq = startFreq + (endFreq - startFreq) * progress;
      }
      sweepFreq.textContent = `${currentFreq < 1000 ? currentFreq.toFixed(1) : (currentFreq / 1000).toFixed(2)} ${currentFreq < 1000 ? 'Hz' : 'kHz'}`;

      if (progress < 1) {
        sweepAnimationId = requestAnimationFrame(updateSweep);
      } else {
        stopAll();
      }
    }
    sweepAnimationId = requestAnimationFrame(updateSweep);
  }

  function stopAll() {
    isPlaying = false;
    if (currentSource) {
      try { currentSource.stop(); } catch {}
      currentSource = null;
    }
    if (sweepAnimationId) {
      cancelAnimationFrame(sweepAnimationId);
      sweepAnimationId = null;
    }
    updateButtonStates();
    updateSweepUI(false);
  }

  function updateButtonStates() {
    const disabled = isPlaying;
    btnLeft.disabled = disabled;
    btnRight.disabled = disabled;
    btnBoth.disabled = disabled;
    btnSweep.disabled = disabled;
    btnStop.disabled = !disabled;
  }

  function updateSweepUI(active: boolean) {
    sweepProgress.style.display = active ? 'block' : 'none';
    if (!active) {
      sweepProgressFill.style.width = '0%';
      sweepFreq.textContent = '—';
    }
  }

  // Event listeners
  volumeInput.addEventListener('input', () => {
    volumeValue.textContent = `${volumeInput.value}%`;
    updateVolume();
  });

  sweepDurationSelect.addEventListener('change', () => {
    sweepDuration = Number(sweepDurationSelect.value);
  });

  sweepTypeSelect.addEventListener('change', () => {
    sweepType = sweepTypeSelect.value;
  });

  btnLeft.addEventListener('click', () => {
    playTone(440, 1, 'left');
    setStatus('Playing 440 Hz on LEFT channel', 'active');
  });

  btnRight.addEventListener('click', () => {
    playTone(440, 1, 'right');
    setStatus('Playing 440 Hz on RIGHT channel', 'active');
  });

  btnBoth.addEventListener('click', () => {
    playTone(440, 1, 'both');
    setStatus('Playing 440 Hz on BOTH channels', 'active');
  });

  btnSweep.addEventListener('click', () => {
    startSweep();
    setStatus(`Frequency sweep: 20 Hz – 20 kHz (${sweepType})`, 'active');
  });

  btnStop.addEventListener('click', () => {
    stopAll();
    setStatus('Stopped', 'idle');
  });

  // Handle visibility change to stop audio when tab is hidden
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stopAll();
  });

  // Initialize
  volumeValue.textContent = `${volumeInput.value}%`;
  setStatus('Ready — click a test button', 'idle');
</script>

<div class="speaker-panel">
  <div class="speaker-header">
    <h2>Speaker Test</h2>
    <p class="speaker-desc">Verify stereo channels and frequency response</p>
  </div>

  <div class="speaker-controls">
    <div class="control-group">
      <label for="speaker-volume">Master Volume <span id="speaker-volume-value">50%</span></label>
      <input type="range" id="speaker-volume" min="0" max="100" step="5" value="50">
    </div>
    <div class="control-group">
      <label for="speaker-sweep-duration">Sweep Duration</label>
      <select id="speaker-sweep-duration">
        <option value="5">5 seconds</option>
        <option value="10" selected>10 seconds</option>
        <option value="20">20 seconds</option>
        <option value="30">30 seconds</option>
      </select>
    </div>
    <div class="control-group">
      <label for="speaker-sweep-type">Sweep Type</label>
      <select id="speaker-sweep-type">
        <option value="logarithmic" selected>Logarithmic</option>
        <option value="linear">Linear</option>
      </select>
    </div>
  </div>

  <div class="speaker-tests">
    <div class="test-group">
      <h3>Channel Tests</h3>
      <p class="test-hint">Each plays a 440 Hz tone for 1 second</p>
      <div class="test-buttons">
        <button id="speaker-left" class="btn btn-primary">🔊 Left Channel</button>
        <button id="speaker-right" class="btn btn-primary">🔊 Right Channel</button>
        <button id="speaker-both" class="btn btn-primary">🔊 Both Channels</button>
      </div>
    </div>

    <div class="test-group">
      <h3>Frequency Sweep</h3>
      <p class="test-hint">Slides from 20 Hz to 20 kHz — listen for dropouts, rattles, or distortion</p>
      <div class="test-buttons">
        <button id="speaker-sweep" class="btn btn-accent">🎵 Start Sweep</button>
      </div>
      <div id="speaker-sweep-progress" class="sweep-progress" style="display: none;">
        <div id="speaker-sweep-progress-fill" class="sweep-progress-fill"></div>
      </div>
      <div class="sweep-info">
        <span>Frequency: <strong id="speaker-sweep-freq">—</strong></span>
      </div>
    </div>
  </div>

  <div class="speaker-actions">
    <button id="speaker-stop" class="btn btn-secondary" disabled>Stop All</button>
  </div>

  <div id="speaker-status" class="speaker-status idle">Ready — click a test button</div>
</div>

<style>
  .speaker-panel { display: flex; flex-direction: column; gap: 1.5rem; padding: 1rem; max-width: 560px; margin: 0 auto; }
  .speaker-header { text-align: center; }
  .speaker-header h2 { margin: 0 0 0.25rem; font-size: 1.5rem; }
  .speaker-desc { color: var(--muted); margin: 0; font-size: 0.875rem; }

  .speaker-controls {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem;
    padding: 1rem; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px;
  }
  .control-group { display: flex; flex-direction: column; gap: 0.25rem; }
  .control-group label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); display: flex; align-items: center; justify-content: space-between; }
  .control-group select, .control-group input[type="range"] { font-size: 0.875rem; }

  .speaker-tests { display: flex; flex-direction: column; gap: 1.5rem; }
  .test-group { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: 8px; padding: 1.5rem; }
  .test-group h3 { margin: 0 0 0.25rem; font-size: 1rem; }
  .test-hint { margin: 0 0 1rem; font-size: 0.875rem; color: var(--muted); }
  .test-buttons { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; }

  .sweep-progress { height: 8px; background: var(--border); border-radius: 4px; overflow: hidden; margin-top: 1rem; }
  .sweep-progress-fill { height: 100%; width: 0%; background: var(--accent); transition: width 0.1s linear; }
  .sweep-info { text-align: center; margin-top: 0.5rem; font-family: monospace; font-size: 1.25rem; color: var(--accent); }

  .speaker-actions { display: flex; justify-content: center; }
  .btn { padding: 0.75rem 1.5rem; border-radius: 6px; font-weight: 600; font-size: 0.875rem; cursor: pointer; border: none; transition: all 0.15s; min-width: 140px; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .btn-primary { background: var(--fg); color: var(--bg); border: 1px solid var(--border); }
  .btn-primary:hover:not(:disabled) { background: var(--fg-hover); }
  .btn-accent { background: var(--accent); color: var(--accent-fg); font-size: 1rem; padding: 1rem 2rem; }
  .btn-accent:hover:not(:disabled) { filter: brightness(1.1); }
  .btn-secondary { background: var(--bg-elevated); color: var(--fg); border: 1px solid var(--border); }
  .btn-secondary:hover:not(:disabled) { background: var(--bg-hover); }

  .speaker-status { text-align: center; padding: 0.75rem; border-radius: 6px; font-size: 0.875rem; transition: all 0.15s; }
  .speaker-status.idle { background: var(--bg-elevated); color: var(--muted); border: 1px solid var(--border); }
  .speaker-status.active { background: rgba(34, 197, 94, 0.1); color: #22c55e; border: 1px solid rgba(34, 197, 94, 0.3); }
  .speaker-status.error { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); }
  .speaker-status.info { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); }
</style>