---
/**
 * The Image Collage workbench: choose several photos, arrange them on a grid,
 * drag the order around and export a PNG/JPEG.
 *
 * The generic file workbench cannot express a drag-to-reorder grid, so the tool
 * opts into this panel via `meta.panel = 'image-collage'`. It reuses the shared
 * option fields for everything the generic form can express and adds a live
 * preview canvas plus a reorderable list on top.
 *
 * The root deliberately does NOT carry `data-file-workbench`: FileWorkbench's
 * generic script binds itself to every `[data-file-workbench]` root and skips
 * only `data-signature-workbench`, so the marker would double-mount this page
 * (two runners on one `[data-run]`) and then crash on the hooks it requires but
 * this panel does not have (`[data-download-all]`). Panel tools are recognised
 * by the `[data-panel-workbench]` wrapper `PanelWorkbench` renders around them.
 *
 * The behaviour lives in `./image-collage-panel.ts`, imported lazily from the
 * script block below so no drag code ships to pages that do not use it.
 */
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '@/components/workbench/OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
const examples = meta.examples ?? [];
const gridHintId = `${p}-grid-hint`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-image-collage-panel
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="true"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose photos</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose image files or drop them here"
  >
    <Icon name="image" size={26} class="opacity-60" />
    <p class="text-sm font-medium">
      Drop PNG, JPEG or WebP photos here, or <span class="link">browse</span>
    </p>
    <p class="text-xs text-[rgb(var(--text-muted))]">Your photos never leave this device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-order></ul>
  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-order-status
    role="status"
    aria-live="polite"
  ></p>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Layout</h2>
  {
    examples.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
        {examples.map((example, index) => (
          <button
            type="button"
            class="chip hover:text-[rgb(var(--text))]"
            data-example={index}
            data-example-options={JSON.stringify(example.options ?? {})}
          >
            {example.title}
          </button>
        ))}
      </div>
    )
  }
  <div class="mt-3">
    <OptionsFields options={meta.options ?? []} idPrefix={p} />
  </div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Preview &amp; order</h2>
  <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" id={gridHintId} data-grid-hint>
    Drag a row to reorder the photos, or use the ◀ / ▶ buttons and arrow keys. The
    order you see is the order that is saved — the preview always matches the export.
  </p>
  <div class="relative mt-3 overflow-hidden rounded-lg border">
    <canvas
      class="block w-full"
      width="16"
      height="9"
      role="img"
      aria-label="Preview of the collage with your photos laid out on the grid"
      data-preview-canvas></canvas>
  </div>
  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-preview-status
    role="status"
    aria-live="polite"
  >
    Choose photos to see the collage here.
  </p>

  <div class="mt-3 flex items-center gap-2.5">
    <button type="button" class="btn btn-ghost" data-reset-order disabled>Reset order</button>
  </div>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Make collage
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out motion-reduce:transition-none"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Building a collage needs JavaScript. Nothing is ever uploaded.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-image-collage-panel]').forEach((panel) => {
    // The drag/reorder code is loaded on demand: only this tool's page pays for it.
    void import('./image-collage-panel')
      .then(({ mountImageCollagePanel }) => mountImageCollagePanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The collage panel could not be loaded in this browser.';
        }
      });
  });
</script>