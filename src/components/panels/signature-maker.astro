---
import type { ToolMeta } from '@/lib/types';
import OptionsFields from '../workbench/OptionsFields.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const id = meta.id;
const headingId = `${id}-heading`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-panel-workbench
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <h1 id={headingId} class="text-xl font-semibold">{meta.name}</h1>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--muted))]">
    {meta.description}
  </p>

  <div class="mt-4 flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <label class="label" for="sig-mode">Mode</label>
      <select id="sig-mode" class="select w-full sm:w-64" data-opt-key="mode">
        <option value="draw">Draw</option>
        <option value="type">Type</option>
      </select>
    </div>

    <div class="flex items-center gap-3" data-sig-type-wrap>
      <label class="label" for="sig-type">Style</label>
      <select id="sig-type" class="select w-full sm:w-64" data-opt-key="style">
        <option value="script">Script</option>
        <option value="classic">Classic</option>
        <option value="modern">Modern</option>
        <option value="mono">Typewriter</option>
      </select>
    </div>

    <div class="flex items-center gap-3" data-sig-text-wrap hidden>
      <label class="label" for="sig-text">Name</label>
      <input
        type="text"
        id="sig-text"
        class="input flex-1"
        placeholder="Your name"
      >
    </div>

    <div class="relative" style="height: 200px;" data-sig-draw-wrap hidden>
      <canvas
        id="sig-canvas"
        class="w-full h-full bg-[rgb(var(--bg-subtle))] rounded-md"
        aria-label="Signature drawing area"
      ></canvas>
    </div>

    <div class="flex items-center gap-3">
      <label class="label" for="sig-format">Format</label>
      <select id="sig-format" class="select w-full sm:w-64" data-opt-key="format">
        <option value="svg">SVG (transparent)</option>
        <option value="png">PNG (transparent)</option>
      </select>
    </div>

    <OptionsFields options={meta.options} idPrefix={id} />

    <div class="flex items-center gap-3">
      <button class="btn" data-sig-generate>Generate</button>
      <button class="btn-secondary" data-sig-clear hidden>Clear</button>
    </div>

    <div class="flex items-center gap-3" hidden data-sig-download-wrap>
      <a class="btn-secondary" data-sig-download download>Download</a>
    </div>
  </div>

  <div class="mt-4 hidden" data-error></div>
  <div class="mt-4 hidden" data-result-wrap></div>

  <noscript>
    <p class="alert alert-warning mt-4">
      This tool requires JavaScript to draw or generate signatures.
    </p>
  </noscript>
</section>

<style>
  /* Ensure canvas fills the draw wrap */
  [data-sig-draw-wrap] canvas {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-panel-workbench][data-tool-id="signature-maker"]').forEach((panel) => {
    void import('./signature-maker.client')
      .then(({ mountSignatureMakerPanel }) => mountSignatureMakerPanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The signature maker panel could not be loaded in this browser.';
        }
      });
  });
</script>