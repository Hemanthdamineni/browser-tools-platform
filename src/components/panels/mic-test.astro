---
/**
 * The microphone test panel.
 *
 * The generic file workbench cannot express a live level meter, a rolling
 * waveform scope and a recorder, so this tool opts into a panel via
 * `meta.panel = 'mic-test'`. The behaviour lives in `./mic-test-panel.ts` and
 * is loaded on demand.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';
import OptionsFields from '@/components/workbench/OptionsFields.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-mic-panel
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2 class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]">
      <Icon name="audio-lines" size={18} /> Microphone test
    </h2>
    <span class="chip">On-device</span>
  </div>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Watch your input level in dBFS, follow the waveform on a rolling scope, then record a clip and
    play it back. Audio is analysed in this tab only — the recording is never uploaded.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-mic-error
    hidden
  >
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-mic-start>
      <Icon name="zap" size={16} /> Start microphone
    </button>
    <button type="button" class="btn btn-ghost" data-mic-stop hidden>
      <Icon name="stop" size={14} /> Stop microphone
    </button>
  </div>

  <p
    class="mt-3 text-sm text-[rgb(var(--text-muted))]"
    data-mic-status
    role="status"
    aria-live="polite"
  >
    Microphone off. Press “Start microphone” to begin.
  </p>

  <div class="mt-4" data-mic-stage hidden>
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <span class="text-sm font-medium text-[rgb(var(--text))]">Input level</span>
      <span class="font-mono text-sm tabular-nums text-[rgb(var(--text))]" data-mic-readout>—</span>
    </div>

    <div
      class="relative mt-1.5 h-3 overflow-hidden rounded-full"
      style="background-color: rgb(var(--bg-inset))"
      role="progressbar"
      aria-valuemin="-60"
      aria-valuemax="0"
      aria-valuenow="-120"
      aria-valuetext="No signal"
      aria-label="Microphone input level in dBFS"
      data-mic-meter
    >
      <div
        class="absolute inset-y-0 left-0 rounded-full"
        style="width: 0%; background-color: rgb(var(--accent))"
        data-mic-fill
      >
      </div>
      <div
        class="absolute inset-y-0 w-0.5 rounded-full"
        style="left: 0%; background-color: rgb(var(--text))"
        data-mic-peak
        hidden
      >
      </div>
    </div>

    <div
      class="mt-1 flex flex-wrap items-center justify-between gap-2 text-xs text-[rgb(var(--text-muted))]"
    >
      <span data-mic-scale>−60 dBFS</span>
      <span data-mic-state>No signal</span>
    </div>

    <!-- The moving bar cannot be read out by a screen reader, so the level is
         also announced in a polite live region (throttled, see the panel). -->
    <p class="sr-only" data-mic-live role="status" aria-live="polite"></p>

    <figure class="mt-5">
      <figcaption class="text-sm font-medium text-[rgb(var(--text))]">Waveform</figcaption>
      <canvas
        class="mt-1.5 h-32 w-full rounded-lg border"
        style="background-color: rgb(var(--bg-inset))"
        data-mic-canvas
        role="img"
        aria-label="Live microphone waveform. No signal yet."
      >
      </canvas>
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]" data-mic-scope-alt>No signal yet.</p>
    </figure>

    <div class="mt-5 flex flex-wrap items-center gap-2.5">
      <button type="button" class="btn btn-primary" data-mic-record disabled>
        <Icon name="audio-lines" size={16} /> Record
      </button>
      <button type="button" class="btn btn-ghost" data-mic-record-stop hidden>
        <Icon name="stop" size={14} /> Stop recording
      </button>
      <span
        class="flex items-center gap-2 text-sm font-medium text-[rgb(var(--text))]"
        data-mic-recording-indicator
        hidden
      >
        <span
          class="inline-block h-2.5 w-2.5 animate-pulse rounded-full"
          style="background-color: rgb(var(--danger))"
          aria-hidden="true"
        >
        </span>
        <span>Recording</span>
        <span class="font-mono tabular-nums" data-mic-timer>0:00.0</span>
      </span>
    </div>

    <div class="mt-4" data-mic-playback hidden>
      <h3 class="text-sm font-semibold text-[rgb(var(--text))]">Your clip</h3>
      <audio
        class="mt-2 w-full"
        controls
        preload="metadata"
        data-mic-audio
        aria-label="Recorded microphone clip"
      >
      </audio>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        <a class="btn btn-subtle btn-sm" data-mic-download download="recording.webm">
          Download the clip
        </a>
        <button type="button" class="btn btn-ghost btn-sm" data-mic-record-again>
          Record again
        </button>
      </div>
      <p class="mt-2 text-xs text-[rgb(var(--text-muted))]" data-mic-clip-meta></p>
    </div>

    <div class="mt-5" data-result-wrap hidden>
      <h3 class="mb-2 text-sm font-semibold text-[rgb(var(--text))]">Measurements</h3>
      <div class="min-w-0" data-mic-report></div>
      <ul class="mt-2 space-y-1 text-xs" data-mic-outputs></ul>
      <ul class="mt-2 space-y-1 text-xs" data-mic-notes></ul>
    </div>
  </div>

  <details class="mt-5 rounded-lg border">
    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
    <div class="border-t p-3" data-mic-options>
      <OptionsFields options={meta.options ?? []} idPrefix={p} />
    </div>
  </details>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      The microphone test needs JavaScript — the browser’s audio APIs cannot run without it.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-mic-panel]').forEach((panel) => {
    // The panel's logic is loaded on demand so no microphone code ships to
    // pages that do not use it.
    void import('./mic-test-panel')
      .then(({ mountMicPanel }) => {
        mountMicPanel(panel);
      })
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-mic-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The microphone panel could not be loaded in this browser.';
        }
      });
  });
</script>
