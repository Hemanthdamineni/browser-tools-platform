---
import type { ToolMeta } from '@/lib/types';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const id = meta.id;
const headingId = `${id}-heading`;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-panel-workbench
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <h1 id={headingId} class="text-xl font-semibold">{meta.name}</h1>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--muted))]">
    {meta.description}
  </p>

  <div class="mt-4 flex flex-col gap-4">
    <div class="flex items-center gap-3">
      <button class="btn" data-mic-record disabled aria-pressed="false">
        <span data-mic-record-label>Record</span>
      </button>
      <button class="btn-secondary" data-mic-stop disabled aria-pressed="false"> Stop </button>
      <span class="text-sm text-[rgb(var(--muted))]" data-mic-status>Waiting for permission…</span>
    </div>

    <div class="flex items-center gap-3">
      <label class="label" for="mic-duration">Default duration</label>
      <input type="number" id="mic-duration" class="input w-24" min="1" max="30" value="5" />
      <span class="text-sm text-[rgb(var(--muted))]">seconds</span>
    </div>

    <div class="relative" style="height: 80px;">
      <canvas
        data-mic-waveform
        width="100%"
        height="100%"
        class="w-full h-full bg-[rgb(var(--bg-subtle))] rounded-md"
        aria-label="Microphone waveform"></canvas>
    </div>

    <div class="flex items-center gap-3">
      <span class="text-sm font-mono text-[rgb(var(--muted))]" data-mic-level>– dB</span>
      <div class="flex-1 h-2 bg-[rgb(var(--bg-subtle))] rounded-full overflow-hidden">
        <div
          class="h-full bg-[rgb(var(--accent))] transition-all duration-75"
          data-mic-meter
          style="width: 0%"
        >
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3" hidden data-mic-playback-wrap>
      <audio controls data-mic-audio preload="auto"></audio>
      <button class="btn-secondary" data-mic-download>Download recording</button>
    </div>
  </div>

  <noscript>
    <p class="alert alert-warning mt-4">
      This tool requires JavaScript to access the microphone and render the waveform.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-panel-workbench][data-tool-id="mic-test"]').forEach((root) => {
    void import('./mic-test')
      .then(({ mountMicTestWorkbench }) => mountMicTestWorkbench(root))
      .catch(() => {
        const status = root.querySelector<HTMLElement>('[data-mic-status]');
        if (status) {
          status.textContent = 'The microphone test could not be loaded in this browser.';
        }
      });
  });
</script>
