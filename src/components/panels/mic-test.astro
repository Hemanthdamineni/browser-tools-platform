---
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const headingId = `${meta.id}-heading`;
const statusId = `${meta.id}-status`;
const deviceId = `${meta.id}-device`;
const fftId = `${meta.id}-fft`;
const smoothingId = `${meta.id}-smoothing`;
const floorId = `${meta.id}-floor`;
const limitId = `${meta.id}-limit`;
const peakLabelId = `${meta.id}-peak-label`;
const rmsLabelId = `${meta.id}-rms-label`;
---

<section
  class="surface mb-4 rounded-lg p-4 sm:p-6"
  data-mic-test-panel
  data-tool-id={meta.id}
  aria-labelledby={headingId}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2
      id={headingId}
      class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]"
    >
      <Icon name="audio-lines" size={18} /> Test your microphone
    </h2>
    <span class="chip">Beta</span>
  </div>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Watch the level meter and waveform to see whether your input is silent, quiet or clipping, then
    record a take and play it back. The microphone stream is analysed and recorded in this tab only
    — nothing is stored or uploaded. Microphone access needs an https:// page, and your browser will
    ask for permission the first time.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-mic-start>
      <Icon name="audio-lines" size={16} /> Enable microphone
    </button>
    <button type="button" class="btn btn-primary" data-mic-record hidden>
      <Icon name="play" size={16} /> Record
    </button>
    <button type="button" class="btn btn-subtle" data-mic-stop hidden>
      <Icon name="stop" size={14} /> Stop recording
    </button>
    <button type="button" class="btn btn-ghost" data-mic-reset hidden>
      <Icon name="x" size={14} /> Reset
    </button>
  </div>

  <div class="mt-3 flex flex-wrap items-center gap-2" data-mic-device-wrap hidden>
    <label for={deviceId} class="text-xs font-medium text-[rgb(var(--text-muted))]"
      >Microphone</label
    >
    <select id={deviceId} class="field !w-auto !py-1 text-sm" data-mic-device></select>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <label for={fftId} class="block text-xs font-medium text-[rgb(var(--text-muted))]">
        Waveform detail
      </label>
      <select id={fftId} class="field mt-1 w-full text-sm" data-mic-fft>
        <option value="1024">1024 samples</option>
        <option value="2048" selected>2048 samples</option>
        <option value="4096">4096 samples</option>
        <option value="8192">8192 samples</option>
      </select>
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
        Higher draws the waveform in more detail.
      </p>
    </div>
    <div>
      <label for={smoothingId} class="block text-xs font-medium text-[rgb(var(--text-muted))]">
        Meter smoothing
      </label>
      <input
        id={smoothingId}
        type="range"
        min="0"
        max="1"
        step="0.05"
        value="0.6"
        class="mt-2 w-full"
        data-mic-smoothing
      />
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
        How slowly the meter follows the level.
      </p>
    </div>
    <div>
      <label for={floorId} class="block text-xs font-medium text-[rgb(var(--text-muted))]">
        Meter floor (dBFS)
      </label>
      <input
        id={floorId}
        type="range"
        min="-120"
        max="-20"
        step="5"
        value="-80"
        class="mt-2 w-full"
        data-mic-floor
      />
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">Bottom of the level bars.</p>
    </div>
    <div>
      <label for={limitId} class="block text-xs font-medium text-[rgb(var(--text-muted))]">
        Recording limit (seconds)
      </label>
      <input
        id={limitId}
        type="number"
        min="5"
        max="600"
        step="5"
        value="60"
        class="field mt-1 w-full text-sm"
        data-mic-limit
      />
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
        Recording stops on its own at this length.
      </p>
    </div>
  </div>

  <p
    id={statusId}
    class="mt-3 text-sm text-[rgb(var(--text-muted))]"
    data-mic-status
    role="status"
    aria-live="polite"
  >
    Microphone off.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-mic-error
    hidden
  >
  </div>

  <div class="mt-4 space-y-3" hidden data-mic-meter-wrap>
    <canvas
      class="h-32 w-full rounded-lg border bg-[rgb(var(--bg-subtle))]"
      data-mic-waveform
      aria-hidden="true"></canvas>

    <div class="space-y-2">
      <div>
        <div class="flex items-center justify-between gap-2 text-xs text-[rgb(var(--text-muted))]">
          <span id={peakLabelId}>Peak</span>
          <span class="font-mono" data-mic-peak-db>−∞ dB</span>
        </div>
        <div
          class="mt-1 h-2.5 w-full overflow-hidden rounded-full bg-[rgb(var(--bg-subtle))]"
          aria-hidden="true"
          data-mic-peak-bar
        >
          <div
            class="h-full w-0 rounded-full"
            style="background-color: rgb(var(--accent))"
            data-mic-peak-fill
          >
          </div>
        </div>
      </div>
      <div>
        <div class="flex items-center justify-between gap-2 text-xs text-[rgb(var(--text-muted))]">
          <span id={rmsLabelId}>RMS (average loudness)</span>
          <span class="font-mono" data-mic-rms-db>−∞ dB</span>
        </div>
        <div
          class="mt-1 h-2.5 w-full overflow-hidden rounded-full bg-[rgb(var(--bg-subtle))]"
          aria-hidden="true"
          data-mic-rms-bar
        >
          <div
            class="h-full w-0 rounded-full"
            style="background-color: rgb(var(--success))"
            data-mic-rms-fill
          >
          </div>
        </div>
      </div>
    </div>

    <p class="text-sm" data-mic-verdict>Waiting for the microphone…</p>
    <p class="font-mono text-xs text-[rgb(var(--text-muted))]" data-mic-timer></p>
  </div>

  <div class="mt-4" hidden data-mic-playback>
    <h3 class="text-sm font-semibold text-[rgb(var(--text))]">Play back</h3>
    <audio
      class="mt-2 w-full"
      controls
      preload="metadata"
      data-mic-audio
      aria-label="Your recording"></audio>
    <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
      Listen for hum, clipping or a channel that stays silent. Save the take with the button under
      the summary.
    </p>
  </div>

  <div class="mt-4 space-y-3" data-mic-results></div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Testing a microphone needs JavaScript. Your operating system's sound settings cover the same
      ground without it.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-mic-test-panel]').forEach((panel) => {
    // The panel's logic is loaded on demand so no microphone code ships to pages
    // that don't test one.
    void import('./mic-test')
      .then(({ mountMicPanel }) => mountMicPanel(panel))
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-mic-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The microphone panel could not be loaded in this browser.';
        }
      });
  });
</script>
