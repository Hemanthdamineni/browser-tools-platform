---
/**
 * The screen recorder panel.
 *
 * Screen capture needs `getDisplayMedia` and `MediaRecorder`, which are
 * main-thread browser APIs — the generic file workbench cannot express that
 * flow, so the tool opts into this panel via `meta.panel = 'screen-recorder'`.
 *
 * The panel captures the screen, hands the finished blob to the tool as a
 * file, and shows the result. Nothing is uploaded: the recording is written by
 * the browser inside this tab.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-screen-recorder-workbench
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2 class="text-base font-semibold text-[rgb(var(--text))]">Record your screen</h2>
    <span class="chip">Beta</span>
  </div>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Your browser records the screen right here in this tab. The file is written on your device and
    never uploaded. Screen sharing needs a secure (https) page, and the browser will ask which
    screen or window you want to record.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-share aria-pressed="false">
      <Icon name="camera" size={16} />
      <span data-share-label>Share screen</span>
    </button>
    <button
      type="button"
      class="btn btn-subtle"
      data-mic
      aria-pressed="false"
      aria-describedby={`${p}-mic-state`}
    >
      <Icon name="audio-lines" size={16} />
      <span>Microphone</span>
    </button>
    <span id={`${p}-mic-state`} class="chip" data-mic-state>off</span>
  </div>

  <div class="mt-4 grid gap-3 sm:grid-cols-2">
    <div>
      <label class="text-xs font-medium" for={`${p}-format`}>Format</label>
      <select class="field mt-1" id={`${p}-format`} data-format>
        <option value="webm">WebM</option>
      </select>
      <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
        MP4 is only listed when this browser can record it.
      </p>
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-quality`}>Quality</label>
      <select class="field mt-1" id={`${p}-quality`} data-quality>
        <option value="2500000">2.5 Mbps — small file</option>
        <option value="5000000" selected>5 Mbps — balanced</option>
        <option value="8000000">8 Mbps — sharp</option>
      </select>
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-start disabled>
      <Icon name="play" size={16} /> Start recording
    </button>
    <button type="button" class="btn btn-ghost" data-stop hidden>
      <Icon name="stop" size={14} /> Stop recording
    </button>
  </div>

  <div class="mt-3 flex items-center gap-2">
    <span class="tb-rec-dot" data-rec-dot aria-hidden="true" hidden></span>
    <span class="font-mono text-lg tabular-nums text-[rgb(var(--text))]" data-timer role="timer"
      >0:00</span
    >
    <span class="text-xs text-[rgb(var(--text-muted))]">elapsed</span>
  </div>

  <p
    class="mt-2 text-sm text-[rgb(var(--text-muted))]"
    data-status
    role="status"
    aria-live="polite"
  >
    Idle — share your screen to begin.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-3" hidden data-preview-wrap>
    <video
      class="w-full max-w-sm rounded-lg border bg-black"
      data-preview
      playsinline
      muted
      autoplay
      aria-label="Live preview of the shared screen"></video>
  </div>

  <div class="mt-3" hidden data-clip-wrap>
    <video
      class="w-full max-w-lg rounded-lg border bg-black"
      data-clip
      controls
      aria-label="Preview of the recording you just made"></video>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <span class="mb-2 block text-sm font-semibold text-[rgb(var(--text))]">Results</span>
    <div class="mb-3 min-w-0" data-report hidden></div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Screen recording needs JavaScript — the browser API that captures the screen is only available
      to a running page.
    </p>
  </noscript>
</section>

<style>
  /*
   * `.btn` sets `display: inline-flex` in the components layer, which beats
   * Tailwind's base-layer `[hidden] { display: none }` — so a hidden button
   * would still be on screen. This panel toggles buttons with the `hidden`
   * attribute, so the attribute has to win here.
   */
  [hidden] {
    display: none !important;
  }

  @keyframes tb-recorder-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .tb-rec-dot {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
    background-color: rgb(var(--danger));
  }

  /* The pulse is decoration only — the status text says what is happening. */
  @media (prefers-reduced-motion: no-preference) {
    .tb-rec-dot {
      animation: tb-recorder-pulse 1.4s ease-in-out infinite;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-screen-recorder-workbench]').forEach((root) => {
    // Loaded on demand: the recorder panel is only used by the screen recorder.
    void import('./screen-recorder-panel')
      .then(({ mountScreenRecorderPanel }) => mountScreenRecorderPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The screen recorder panel could not be loaded in this browser.';
        }
      });
  });
</script>
