---
/**
 * The BPM detector panel.
 *
 * The generic file workbench cannot express a live microphone listen loop or a
 * tap-to-beat button, so this tool opts into a panel via `meta.panel =
 * 'bpm-detector'`. The behaviour lives in `./bpm-detector-panel.ts` and is
 * loaded on demand. Nothing is uploaded: the file and the microphone are read
 * entirely by this tab.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';
import OptionsFields from '@/components/workbench/OptionsFields.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-bpm-panel
  data-tool-id={meta.id}
  aria-label={`${meta.name} workbench`}
>
  <div class="flex flex-wrap items-center gap-2">
    <h2 class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]">
      <Icon name="audio-lines" size={18} /> BPM detector
    </h2>
    <span class="chip">On-device</span>
  </div>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Find the tempo of a song from a file or your microphone. Onset detection and autocorrelation run
    in this tab — the audio is never uploaded.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-bpm-error
    hidden
  >
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <label class="btn btn-primary cursor-pointer">
      <Icon name="file-text" size={16} />
      <span>Choose an audio file</span>
      <input class="sr-only" type="file" accept={meta.accept ?? 'audio/*'} data-bpm-file />
    </label>
    <button type="button" class="btn btn-ghost" data-bpm-mic>
      <Icon name="zap" size={16} /> Use microphone
    </button>
    <button type="button" class="btn btn-ghost" data-bpm-mic-stop hidden>
      <Icon name="stop" size={14} /> Stop microphone
    </button>
  </div>

  <p
    class="mt-3 text-sm text-[rgb(var(--text-muted))]"
    data-bpm-status
    role="status"
    aria-live="polite"
  >
    Choose an audio file, or press “Use microphone” and tap along to the beat.
  </p>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-subtle" data-bpm-tap>
      <Icon name="play" size={16} /> Tap (space)
    </button>
    <button type="button" class="btn btn-ghost" data-bpm-tap-reset>
      <Icon name="wrench" size={14} /> Reset
    </button>
  </div>

  <div class="mt-4" data-bpm-result-wrap hidden>
    <h3 class="mb-2 text-sm font-semibold text-[rgb(var(--text))]">Tempo</h3>
    <div class="min-w-0" data-bpm-report></div>
    <ul class="mt-2 space-y-1 text-xs" data-bpm-notes></ul>
  </div>

  <details class="mt-5 rounded-lg border">
    <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
    <div class="border-t p-3" data-bpm-options>
      <OptionsFields options={meta.options ?? []} idPrefix={p} />
    </div>
  </details>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      The BPM detector needs JavaScript — the audio analysis cannot run without it.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-bpm-panel]').forEach((panel) => {
    // The panel's logic is loaded on demand so no DSP code ships to pages that
    // do not use it.
    void import('./bpm-detector-panel')
      .then(({ mountBpmDetectorPanel }) => {
        mountBpmDetectorPanel(panel);
      })
      .catch(() => {
        const error = panel.querySelector<HTMLElement>('[data-bpm-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The BPM detector panel could not be loaded in this browser.';
        }
      });
  });
</script>
