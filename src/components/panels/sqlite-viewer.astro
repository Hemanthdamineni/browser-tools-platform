---
/**
 * The SQLite viewer workbench: choose a `.db` / `.sqlite` file, browse its
 * tables, dump the schema, run one read-only statement and export the result
 * as CSV or JSON. The generic file workbench cannot express this flow (a table
 * list that runs a query per click, a schema view, a SQL editor), so the tool
 * opts into this panel via `meta.panel = 'sqlite-viewer'`.
 *
 * Everything that touches the database happens in the tool's Web Worker
 * (`sqlite-viewer.tool.ts`), driven by `runToolById`; this component only
 * renders the controls and the results.
 */
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-sqlite-viewer-workbench
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose the database</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a SQLite database file or drop it here"
  >
    <Icon name="file-text" size={26} class="opacity-60" />
    <p class="text-sm font-medium">
      Drop a SQLite file here, or <span class="link">browse</span>
    </p>
    <p class="text-xs text-[rgb(var(--text-muted))]">
      <code>.db</code>, <code>.sqlite</code>, <code>.sqlite3</code> or <code>.db3</code>. Opened on
      this device with SQLite in WebAssembly — nothing is uploaded.
    </p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Explore the tables</h2>
  <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
    Pick a table to browse its rows, or view its <code>CREATE</code> statements. The list and the row
    counts come from the database itself.
  </p>
  <ul class="mt-3 space-y-1.5" data-tables aria-label="Tables and views in the database" hidden>
  </ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Run a statement</h2>
  <label class="mt-2 block text-xs font-medium" for={`${p}-query`}>SQL statement</label>
  <textarea
    class="field mt-1.5 font-mono text-xs"
    id={`${p}-query`}
    rows="4"
    spellcheck="false"
    placeholder="SELECT * FROM users LIMIT 50;"
    data-query></textarea>
  <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
    Read-only. SELECT, WITH, VALUES, TABLE, EXPLAIN, metadata PRAGMAs and the
    <code>.tables</code> / <code>.schema</code> shortcuts run; anything that writes is refused.
  </p>

  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div class="flex min-w-0 flex-col gap-1.5">
      <label class="text-xs font-medium" for={`${p}-export`}>Export the result</label>
      <select class="field !w-48" id={`${p}-export`} data-export>
        <option value="none" selected>Do not export</option>
        <option value="csv">CSV file</option>
        <option value="json">JSON file</option>
      </select>
    </div>
    <div class="flex min-w-0 flex-col gap-1.5">
      <label class="text-xs font-medium" for={`${p}-rows`}>Rows to show</label>
      <input
        class="field !w-28"
        id={`${p}-rows`}
        type="number"
        min="1"
        max="100000"
        step="1"
        value="500"
        data-max-rows
      />
    </div>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} />
      <span data-run-label>Run statement</span>
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Result</span>
      <span class="flex flex-wrap gap-3 text-xs text-[rgb(var(--text-muted))]" data-stats></span>
    </div>
    <div data-output></div>
    <ul class="mt-2 space-y-2" data-outputs hidden></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Browsing a SQLite database needs JavaScript. You can still open the file in a desktop SQLite
      client.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-sqlite-viewer-workbench]').forEach((root) => {
    // Loaded on demand: the viewer panel is only used by this tool.
    void import('./sqlite-viewer-panel')
      .then(({ mountSqliteViewerPanel }) => mountSqliteViewerPanel(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The SQLite viewer panel could not be loaded in this browser.';
        }
      });
  });
</script>
