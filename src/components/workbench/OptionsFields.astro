---
import type { ToolOption } from '@/lib/types';

interface Props {
  options: ToolOption[];
  idPrefix: string;
}
const { options, idPrefix } = Astro.props;

const fieldId = (key: string) => `${idPrefix}-opt-${key}`;
---

<div class="grid gap-4 sm:grid-cols-2" data-options>
  {
    options.map((opt) => {
      const id = fieldId(opt.key);
      const helpId = `${id}-help`;
      const describedBy = opt.help && opt.type !== 'boolean' ? helpId : undefined;
      const showWhen = opt.showWhen ? JSON.stringify(opt.showWhen) : undefined;
      const wide = opt.type === 'textarea';
      return (
        <div
          class:list={['flex min-w-0 flex-col gap-1.5', wide && 'sm:col-span-2']}
          data-option-wrap={opt.key}
          data-show-when={showWhen}
        >
          {opt.type !== 'boolean' && (
            <label for={id} class="text-sm font-medium text-[rgb(var(--text))]">
              {opt.label}
            </label>
          )}

          {opt.type === 'select' && (
            <select id={id} class="field" data-opt-key={opt.key} data-opt-type="select" aria-describedby={describedBy}>
              {opt.choices.map((c) => (
                <option value={c.value} selected={c.value === opt.default}>{c.label}</option>
              ))}
            </select>
          )}

          {opt.type === 'boolean' && (
            <label class="flex cursor-pointer items-center gap-2.5 rounded-lg border px-3 py-2 text-sm transition-colors hover:bg-[rgb(var(--bg-subtle))]">
              <input
                id={id}
                type="checkbox"
                class="h-4 w-4 shrink-0 rounded accent-[rgb(var(--accent))]"
                data-opt-key={opt.key}
                data-opt-type="boolean"
                checked={opt.default}
              />
              <span class="text-[rgb(var(--text))]">{opt.label}</span>
            </label>
          )}

          {opt.type === 'number' && (
            <input
              id={id}
              type="number"
              class="field"
              data-opt-key={opt.key}
              data-opt-type="number"
              value={opt.default}
              min={opt.min}
              max={opt.max}
              step={opt.step ?? 1}
              aria-describedby={describedBy}
            />
          )}

          {opt.type === 'range' && (
            <div class="flex items-center gap-3">
              <input
                id={id}
                type="range"
                class="h-1.5 w-full cursor-pointer appearance-none rounded-full accent-[rgb(var(--accent))]"
                style="background-color: rgb(var(--bg-inset))"
                data-opt-key={opt.key}
                data-opt-type="number"
                value={opt.default}
                min={opt.min}
                max={opt.max}
                step={opt.step ?? 1}
                aria-describedby={describedBy}
              />
              <output class="w-14 shrink-0 text-right font-mono text-sm tabular-nums text-[rgb(var(--text-muted))]" data-range-out={opt.key}>
                {opt.default}
              </output>
            </div>
          )}

          {opt.type === 'text' && (
            <input
              id={id}
              type="text"
              class="field"
              data-opt-key={opt.key}
              data-opt-type="text"
              value={opt.default}
              placeholder={opt.placeholder}
              aria-describedby={describedBy}
            />
          )}

          {opt.type === 'textarea' && (
            <textarea
              id={id}
              class="field !min-h-[5rem]"
              data-opt-key={opt.key}
              data-opt-type="text"
              placeholder={opt.placeholder}
              aria-describedby={describedBy}
              set:text={opt.default}
            />
          )}

          {opt.help && opt.type !== 'boolean' && (
            <p id={helpId} class="text-xs leading-relaxed text-[rgb(var(--text-muted))]">{opt.help}</p>
          )}
        </div>
      );
    })
  }
</div>
