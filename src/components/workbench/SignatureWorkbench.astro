---
/**
 * The signing workbench: choose a PDF, create a signature, place it on the
 * page and flatten it into the document.
 *
 * The generic file workbench cannot express this flow (a drawing pad, a page
 * preview and a draggable signature), so the tool opts into this panel via
 * `meta.panel = 'signature'`.
 */
import type { ToolMeta } from '@/lib/types';
import SignatureCapture from '@/components/signature/SignatureCapture.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-signature-workbench
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple="false"
  aria-label={`${meta.name} workbench`}
>
  <h2 class="text-base font-semibold text-[rgb(var(--text))]">1 · Choose the PDF to sign</h2>
  <div
    class="drop-zone mt-3 flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-8 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose a PDF file or drop it here"
  >
    <Icon name="file-text" size={26} class="opacity-60" />
    <p class="text-sm font-medium">Drop a PDF here, or <span class="link">browse</span></p>
    <p class="text-xs text-[rgb(var(--text-muted))]">The file never leaves your device.</p>
  </div>
  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">2 · Create your signature</h2>
  <div class="mt-3">
    <SignatureCapture idPrefix={`${p}-signature`} />
  </div>

  <h2 class="mt-6 text-base font-semibold text-[rgb(var(--text))]">3 · Place it on the page</h2>
  <div class="mt-3 flex flex-wrap items-end gap-3">
    <div>
      <label class="text-xs font-medium" for={`${p}-page`}>Page</label>
      <input
        class="field mt-1 !w-24"
        id={`${p}-page`}
        type="number"
        min="1"
        step="1"
        value="1"
        data-page-input
      />
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-x`}>X (pt from the left)</label>
      <input
        class="field mt-1 !w-32"
        id={`${p}-x`}
        type="number"
        step="1"
        min="0"
        data-placement="x"
      />
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-y`}>Y (pt from the top)</label>
      <input
        class="field mt-1 !w-32"
        id={`${p}-y`}
        type="number"
        step="1"
        min="0"
        data-placement="y"
      />
    </div>
    <div>
      <label class="text-xs font-medium" for={`${p}-width`}>Width (pt)</label>
      <input
        class="field mt-1 !w-32"
        id={`${p}-width`}
        type="number"
        step="1"
        min="8"
        data-placement="width"
      />
    </div>
  </div>

  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    id={`${p}-placement-hint`}
    data-placement-hint
  >
    Drag the signature to move it, or focus it and use the arrow keys.
  </p>

  <div class="relative mt-3 overflow-hidden rounded-lg border" data-preview>
    <canvas class="block w-full" width="595" height="842" data-page-canvas></canvas>
    <div
      class="absolute cursor-move touch-none rounded-sm ring-2 ring-[rgb(var(--accent))]"
      data-signature-box
      tabindex="0"
      role="group"
      aria-label="Signature on the page. Press the arrow keys to move it, or use the width field to resize it."
      aria-describedby={`${p}-placement-hint`}
      hidden
    >
      <img class="pointer-events-none block h-full w-full" data-signature-image alt="" />
      <span
        class="absolute -bottom-2 -right-2 block h-4 w-4 cursor-nwse-resize rounded-full border-2 border-white"
        style="background-color: rgb(var(--accent))"
        data-resize-handle
        aria-hidden="true"
      >
      </span>
    </div>
  </div>
  <p
    class="mt-2 text-xs text-[rgb(var(--text-muted))]"
    data-preview-status
    role="status"
    aria-live="polite"
  >
    Choose a PDF to see the page.
  </p>

  <div class="mt-5 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Sign PDF
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-signature-workbench]').forEach((root) => {
    // Loaded on demand: the signing panel is only used by the PDF signer.
    void import('./signature-workbench')
      .then(({ mountSignatureWorkbench }) => mountSignatureWorkbench(root))
      .catch(() => {
        const error = root.querySelector<HTMLElement>('[data-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The signing panel could not be loaded in this browser.';
        }
      });
  });
</script>
