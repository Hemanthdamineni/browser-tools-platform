---
import type { ToolMeta } from '@/lib/types';
import OptionsFields from './OptionsFields.astro';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const options = meta.options ?? [];
const examples = meta.acceptsText ? (meta.examples ?? []) : [];
const p = meta.id;
---

<section
  class="surface rounded-lg p-4 sm:p-6"
  data-file-workbench
  data-tool-id={meta.id}
  data-accept={meta.accept ?? ''}
  data-multiple={meta.multiple ? 'true' : 'false'}
  aria-label={`${meta.name} workbench`}
>
  <div
    class="drop-zone flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border-2 border-dashed px-4 py-10 text-center transition-colors"
    data-drop
    role="button"
    tabindex="0"
    aria-label="Choose files or drop them here"
  >
    <Icon name="download" size={28} class="opacity-60" />
    <p class="text-sm font-medium">
      Drop {meta.multiple ? 'files' : 'a file'} here, or <span class="link">browse</span>
    </p>
    {meta.accept && <p class="text-xs text-[rgb(var(--text-muted))]">Accepts: {meta.accept}</p>}
    <p class="text-xs text-[rgb(var(--text-muted))]">Files stay on your device.</p>
  </div>

  <ul class="mt-3 space-y-1.5 text-sm" data-file-list></ul>

  {
    meta.acceptsText && (
      <div class="mt-4">
        {examples.length > 0 && (
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-xs font-medium text-[rgb(var(--text-muted))]">Try:</span>
            {examples.map((ex, i) => (
              <button
                type="button"
                class="chip hover:text-[rgb(var(--text))]"
                data-example={i}
                data-example-payload={JSON.stringify({
                  input: ex.input ?? '',
                  options: ex.options ?? {},
                })}
              >
                {ex.title}
              </button>
            ))}
          </div>
        )}
        <label for={`${p}-text-input`} class="text-sm font-medium">
          Or paste text directly
        </label>
        <textarea
          id={`${p}-text-input`}
          class="field mt-1.5"
          rows="6"
          spellcheck="false"
          autocapitalize="off"
          autocomplete="off"
          data-text-input
          placeholder="Type or paste here…"
        />
        <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
          Text is processed on this device. If a file is selected, the file is used instead.
        </p>
      </div>
    )
  }

  {
    options.length > 0 && (
      <details class="mt-4 rounded-lg border" open>
        <summary class="cursor-pointer select-none px-3 py-2 text-sm font-medium">Options</summary>
        <div class="border-t p-3">
          <OptionsFields options={options} idPrefix={p} />
        </div>
      </details>
    )
  }

  <div class="mt-4 flex flex-wrap items-center gap-2.5">
    <button type="button" class="btn btn-primary" data-run disabled>
      <Icon name="zap" size={16} /> Process
    </button>
    <button type="button" class="btn btn-ghost" data-cancel hidden>Cancel</button>
    <button type="button" class="btn btn-ghost" data-reset hidden>Reset</button>
    {
      meta.acceptsText && (
        <>
          <label
            class="flex cursor-pointer items-center gap-2 text-sm text-[rgb(var(--text-muted))]"
            title="Keep your last pasted text and options for this tool, in this browser only."
          >
            <input type="checkbox" class="h-4 w-4 rounded" data-remember />
            Remember input
          </label>
          <button
            type="button"
            class="btn btn-subtle btn-sm"
            data-copy-link
            title="Share your pasted text and options via a link"
          >
            <Icon name="copy" size={14} /> Copy link
          </button>
        </>
      )
    }
  </div>

  <div class="mt-3 space-y-2" hidden data-skeleton aria-hidden="true">
    <div class="tb-skeleton h-4 w-1/3"></div>
    <div class="tb-skeleton h-20 w-full"></div>
  </div>

  <div class="mt-3 rounded-lg border border-dashed px-4 py-6 text-center" data-empty>
    <p class="text-sm font-medium text-[rgb(var(--text))]">
      Drop {meta.multiple ? 'files' : 'a file'} above to begin
    </p>
    <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
      Your {meta.multiple ? 'files' : 'file'} are processed on this device and never uploaded.
    </p>
  </div>

  <div class="mt-3" hidden data-progress-wrap>
    <div class="h-2 overflow-hidden rounded-full" style="background-color: rgb(var(--bg-inset))">
      <div
        class="h-full transition-[width] duration-200 ease-out"
        style="width:0%; background-color: rgb(var(--accent))"
        data-progress-bar
      >
      </div>
    </div>
    <p
      class="mt-1 text-xs tabular-nums text-[rgb(var(--text-muted))]"
      data-progress-msg
      aria-live="polite"
    >
    </p>
  </div>

  <div
    class="mt-4 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-error
    hidden
  >
  </div>

  <div class="mt-4" hidden data-result-wrap>
    <div class="mb-2 flex items-center justify-between">
      <span class="text-sm font-semibold text-[rgb(var(--text))]" data-result-title>Results</span>
      <button type="button" class="btn btn-subtle btn-sm" data-download-all hidden>
        <Icon name="archive" size={14} /> Download all (.zip)
      </button>
    </div>
    <div data-report hidden class="mb-3 min-w-0"></div>
    <div
      class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[rgb(var(--text-muted))]"
      data-stats
    >
    </div>
    <ul class="space-y-2" data-outputs></ul>
    <ul class="mt-2 space-y-1 text-xs" data-notes></ul>
  </div>
</section>

<script>
  import { runToolById } from '@/lib/worker/client';
  import { createDropZone, downloadBlob, downloadZip, validateFileSelection } from '@/lib/files';
  import { escapeHtml, formatBytes } from '@/lib/format';
  import {
    readOptions,
    applyShowWhen,
    bindRangeOutputs,
    showError,
    clearError,
    renderTextResult,
    setOptions,
    snapshotOptions,
    resetOptions,
    revealResult,
    notify,
  } from './shared';
  import {
    isRememberEnabled,
    setRememberEnabled,
    saveDraft,
    loadDraft,
    clearDraft,
    encodeHash,
    decodeHash,
    isMeaningful,
  } from './state';
  import { onRunShortcutClick } from '../keyboard';
  import { copyText } from '@/lib/clipboard';
  import type { FileRunResult, OptionValues } from '@/lib/types';

  document.querySelectorAll<HTMLElement>('[data-file-workbench]').forEach((root) => {
    // The dedicated signing panel reuses the `data-file-workbench` marker (the
    // shared e2e checks look for it) but mounts itself — skip it here.
    if (root.hasAttribute('data-signature-workbench')) return;
    // Other dedicated panels (the data URI panel, for one) reuse the same
    // marker so the shared e2e checks still find a workbench, but they mount
    // themselves. The generic file workbench is the only one with a
    // "download all" button, so a root without it belongs to such a panel.
    if (!root.querySelector('[data-download-all]')) return;
    const toolId = root.dataset.toolId!;
    const accept = root.dataset.accept || undefined;
    const multiple = root.dataset.multiple === 'true';
    const dropEl = root.querySelector<HTMLElement>('[data-drop]')!;
    const listEl = root.querySelector<HTMLUListElement>('[data-file-list]')!;
    const runBtn = root.querySelector<HTMLButtonElement>('[data-run]')!;
    const cancelBtn = root.querySelector<HTMLButtonElement>('[data-cancel]')!;
    const resetBtn = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const errorBox = root.querySelector<HTMLElement>('[data-error]')!;
    const progressWrap = root.querySelector<HTMLElement>('[data-progress-wrap]')!;
    const progressBar = root.querySelector<HTMLElement>('[data-progress-bar]')!;
    const progressMsg = root.querySelector<HTMLElement>('[data-progress-msg]')!;
    const resultWrap = root.querySelector<HTMLElement>('[data-result-wrap]')!;
    const reportEl = root.querySelector<HTMLElement>('[data-report]')!;
    const statsEl = root.querySelector<HTMLElement>('[data-stats]')!;
    const outputsEl = root.querySelector<HTMLUListElement>('[data-outputs]')!;
    const notesEl = root.querySelector<HTMLUListElement>('[data-notes]')!;
    const downloadAllBtn = root.querySelector<HTMLButtonElement>('[data-download-all]')!;
    const optionsRoot = root.querySelector<HTMLElement>('[data-options]') ?? root;
    // Only tools that opt in (`meta.acceptsText`) get the extra textarea; for
    // every other file tool this is null and the behaviour is unchanged.
    const textEl = root.querySelector<HTMLTextAreaElement>('[data-text-input]');
    const acceptsText = textEl !== null;
    const rememberBox = root.querySelector<HTMLInputElement>('[data-remember]');
    const copyLinkBtn = root.querySelector<HTMLButtonElement>('[data-copy-link]');
    const emptyState = root.querySelector<HTMLElement>('[data-empty]');
    const skeleton = root.querySelector<HTMLElement>('[data-skeleton]');

    let files: File[] = [];
    let controller: AbortController | null = null;
    // Bumped on every run and on reset so a late worker reply from a cancelled
    // run can never publish a stale result.
    let runGeneration = 0;
    let outputs: { filename: string; blob: Blob }[] = [];
    const previewUrls = new Set<string>();

    /** The shareable part of a file tool's state: pasted text + options. */
    function snapshot() {
      return { input: pastedText(), options: readOptions(optionsRoot) };
    }

    function restore(snapshotState: { input: string; options: Record<string, unknown> }) {
      if (textEl) textEl.value = snapshotState.input;
      setOptions(optionsRoot, snapshotState.options);
      applyShowWhen(optionsRoot);
      syncRunState();
    }

    function syncHash() {
      const state = snapshot();
      if (!isMeaningful(state)) return;
      const hash = encodeHash(state);
      if (!hash) return;
      try {
        history.replaceState(null, '', `${location.pathname}${location.search}#${hash}`);
      } catch {
        /* history unavailable — link still built on demand */
      }
    }

    // Ctrl/⌘+Enter runs the current tool.
    onRunShortcutClick(root, window);

    function revokePreviews() {
      for (const url of previewUrls) URL.revokeObjectURL(url);
      previewUrls.clear();
    }

    bindRangeOutputs(root);
    // Capture the declared defaults before any saved/shared state is applied,
    // so an example can reset the form to a clean slate first.
    snapshotOptions(optionsRoot);
    applyShowWhen(optionsRoot);

    function renderList() {
      listEl.innerHTML = files
        .map(
          (f, i) => `
        <li class="flex items-center justify-between gap-3 rounded-lg border px-3 py-1.5">
          <span class="truncate">${escapeHtml(f.name)}</span>
          <span class="flex items-center gap-2 shrink-0 text-xs text-[rgb(var(--text-muted))]">
            ${formatBytes(f.size)}
            <button type="button" data-remove="${i}" aria-label="Remove ${escapeHtml(f.name)}" class="hover:text-[rgb(var(--danger))]">✕</button>
          </span>
        </li>`,
        )
        .join('');
      syncRunState();
    }

    /** The pasted text, or '' when the tool does not accept text. */
    function pastedText(): string {
      return acceptsText ? textEl!.value : '';
    }

    function hasPastedText(): boolean {
      return pastedText().length > 0;
    }

    /**
     * The Run button is enabled once a file is chosen — and, for tools that
     * also accept text, as soon as the textarea has content.
     */
    function syncRunState() {
      const ready = files.length > 0 || hasPastedText();
      runBtn.disabled = !ready;
      resetBtn.hidden = !ready;
      // The "drop a file to begin" placeholder only shows before any input.
      emptyState?.toggleAttribute('hidden', ready);
    }

    function addFiles(incoming: File[]) {
      files = multiple ? [...files, ...incoming] : incoming.slice(0, 1);
      clearError(errorBox);
      const limit = validateFileSelection(files);
      if (limit) {
        showError(errorBox, limit);
      }
      resultWrap.hidden = true;
      renderList();
    }

    const dz = createDropZone(dropEl, { accept, multiple, onFiles: addFiles });

    listEl.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-remove]');
      if (!btn) return;
      files.splice(Number(btn.dataset.remove), 1);
      renderList();
    });

    optionsRoot.addEventListener('input', () => applyShowWhen(optionsRoot));
    optionsRoot.addEventListener('change', () => applyShowWhen(optionsRoot));

    async function run() {
      if (!files.length && !hasPastedText()) return;
      const limit = validateFileSelection(files);
      if (limit) {
        showError(errorBox, limit);
        return;
      }
      controller?.abort();
      const generation = ++runGeneration;
      controller = new AbortController();
      clearError(errorBox);
      skeleton?.removeAttribute('hidden');
      runBtn.disabled = true;
      cancelBtn.hidden = false;
      progressWrap.hidden = false;
      progressBar.style.width = '0%';
      progressMsg.textContent = 'Working…';
      outputs = [];
      revokePreviews();

      try {
        // Only tools that opt in receive the typed text; every other file tool
        // gets exactly the payload it got before.
        const payload: { files: File[]; options: OptionValues; text?: string } = {
          files,
          options: readOptions(optionsRoot),
        };
        if (acceptsText) payload.text = pastedText();
        const result = await runToolById<FileRunResult>(toolId, payload, {
          signal: controller.signal,
          onProgress: (fraction, message) => {
            if (generation !== runGeneration) return;
            const pct = Math.round(Math.min(1, Math.max(0, fraction)) * 100);
            progressBar.style.width = `${pct}%`;
            // The progress message region is aria-live="polite"; always include
            // the percentage so screen readers announce progress + completion.
            progressMsg.textContent = message ? `${message} — ${pct}%` : `${pct}%`;
          },
        });
        if (generation !== runGeneration) return;
        progressBar.style.width = '100%';
        progressMsg.textContent = 'Done';
        skeleton?.setAttribute('hidden', '');
        outputs = result.outputs;
        renderOutputs(result);
      } catch (err) {
        if (generation !== runGeneration) return;
        skeleton?.setAttribute('hidden', '');
        const e = err as Error & { hint?: string };
        if (e.name !== 'AbortError') showError(errorBox, e.message || 'Processing failed', e.hint);
        else progressMsg.textContent = 'Cancelled';
      } finally {
        if (generation === runGeneration) {
          runBtn.disabled = false;
          cancelBtn.hidden = true;
          controller = null;
        }
      }
    }

    function renderOutputs(result: FileRunResult) {
      resultWrap.hidden = false;
      revealResult(resultWrap);
      // Inline report (e.g. metadata tables) — shown above any downloadable outputs.
      if (result.report) {
        renderTextResult(reportEl, {
          output: result.report.output,
          render: result.report.render,
          language: result.report.language,
        });
        reportEl.hidden = false;
      } else {
        reportEl.hidden = true;
        reportEl.innerHTML = '';
      }
      statsEl.innerHTML = '';
      const statsEntries = Object.entries(result.stats ?? {});
      statsEl.hidden = statsEntries.length === 0;
      for (const [key, value] of statsEntries) {
        const span = document.createElement('span');
        // Keys and values are tool output, so both are escaped before being
        // turned into HTML — a hostile value can never inject elements.
        span.innerHTML = `<span class="font-medium text-[rgb(var(--text))]">${escapeHtml(key)}:</span> ${escapeHtml(String(value))}`;
        statsEl.appendChild(span);
      }
      outputsEl.innerHTML = '';
      result.outputs.forEach((o, i) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between gap-3 rounded-lg border px-3 py-2';
        const left = document.createElement('div');
        left.className = 'flex min-w-0 items-center gap-3';
        if (o.previewUrl) {
          const img = document.createElement('img');
          img.src = o.previewUrl;
          img.alt = '';
          img.className = 'h-10 w-10 rounded object-cover';
          left.appendChild(img);
          if (o.previewUrl.startsWith('blob:')) previewUrls.add(o.previewUrl);
        }
        const name = document.createElement('span');
        name.className = 'truncate text-sm';
        name.textContent = `${o.filename} · ${formatBytes(o.blob.size)}`;
        left.appendChild(name);
        const dl = document.createElement('button');
        dl.type = 'button';
        dl.className = 'btn btn-subtle btn-sm shrink-0';
        dl.textContent = 'Save';
        dl.addEventListener('click', () => downloadBlob(o.blob, o.filename));
        li.append(left, dl);
        outputsEl.appendChild(li);
        void i;
      });
      downloadAllBtn.hidden = result.outputs.length < 2;
      notesEl.innerHTML = '';
      for (const w of result.warnings ?? []) {
        const li = document.createElement('li');
        li.style.color = 'rgb(var(--warning))';
        li.textContent = `⚠ ${w}`;
        notesEl.appendChild(li);
      }
      for (const n of result.notes ?? []) {
        const li = document.createElement('li');
        li.className = 'text-[rgb(var(--text-muted))]';
        li.textContent = n;
        notesEl.appendChild(li);
      }
    }

    runBtn.addEventListener('click', run);
    cancelBtn.addEventListener('click', () => controller?.abort());
    resetBtn.addEventListener('click', () => {
      // Invalidate any in-flight run so a late worker reply cannot re-publish a
      // result the user just cleared.
      runGeneration += 1;
      controller?.abort();
      controller = null;
      files = [];
      if (textEl) textEl.value = '';
      outputs = [];
      revokePreviews();
      renderList();
      resultWrap.hidden = true;
      outputsEl.innerHTML = '';
      statsEl.innerHTML = '';
      notesEl.innerHTML = '';
      reportEl.hidden = true;
      reportEl.innerHTML = '';
      downloadAllBtn.hidden = true;
      progressWrap.hidden = true;
      skeleton?.setAttribute('hidden', '');
      emptyState?.removeAttribute('hidden');
      clearError(errorBox);
    });
    downloadAllBtn.addEventListener('click', () => downloadZip(outputs, `${toolId}-output.zip`));

    // Typing in the textarea re-enables Run (for tools that accept text) and
    // hides the now-stale result.
    let persistTimer: ReturnType<typeof setTimeout> | undefined;
    function schedulePersist() {
      clearTimeout(persistTimer);
      persistTimer = setTimeout(() => {
        if (rememberBox?.checked) saveDraft(toolId, snapshot());
        syncHash();
      }, 500);
    }
    textEl?.addEventListener('input', () => {
      syncRunState();
      resultWrap.hidden = true;
      clearError(errorBox);
      schedulePersist();
    });
    optionsRoot.addEventListener('input', () => {
      applyShowWhen(optionsRoot);
      schedulePersist();
    });
    optionsRoot.addEventListener('change', () => {
      applyShowWhen(optionsRoot);
      schedulePersist();
    });

    // Opt-in "remember my input" — off until the visitor ticks the box.
    rememberBox?.addEventListener('change', () => {
      setRememberEnabled(rememberBox.checked);
      if (rememberBox.checked) saveDraft(toolId, snapshot());
      else clearDraft(toolId);
    });

    // Copy a shareable link carrying the current pasted text + options.
    copyLinkBtn?.addEventListener('click', async () => {
      syncHash();
      const url = `${location.origin}${location.pathname}${location.search}${location.hash}`;
      const ok = await copyText(url);
      notify(ok ? 'Link copied' : 'Copy failed');
    });

    // Restore shared/remembered state on load (text + options only).
    if (rememberBox) rememberBox.checked = isRememberEnabled();
    const shared = decodeHash(location.hash);
    if (isMeaningful(shared)) {
      restore(shared);
    } else if (rememberBox?.checked) {
      const draft = loadDraft(toolId);
      if (draft) restore(draft);
    }

    // Example chips fill the textarea (and the options) and run straight away.
    root.querySelectorAll<HTMLButtonElement>('[data-example]').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const payload = JSON.parse(btn.dataset.examplePayload!) as {
            input: string;
            options: Record<string, unknown>;
          };
          if (textEl) textEl.value = payload.input;
          resetOptions(optionsRoot);
          setOptions(optionsRoot, payload.options);
          applyShowWhen(optionsRoot);
          syncRunState();
          schedulePersist();
          run();
        } catch {
          /* malformed example */
        }
      });
    });

    window.addEventListener(
      'beforeunload',
      () => {
        controller?.abort();
        runGeneration += 1;
        revokePreviews();
        dz.destroy();
      },
      { once: true },
    );
  });
</script>
