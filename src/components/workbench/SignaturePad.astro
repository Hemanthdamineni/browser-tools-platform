---
import type { ToolMeta } from '@/lib/types';
import Icon from '@/components/Icon.astro';

interface Props {
  meta: ToolMeta;
}
const { meta } = Astro.props;
const headingId = `${meta.id}-signature-heading`;
const statusId = `${meta.id}-signature-status`;
const fileId = `${meta.id}-signature-file`;
const textId = `${meta.id}-signature-text`;
const modeName = `${meta.id}-signature-mode`;
---

<section
  class="surface mb-4 rounded-lg p-4 sm:p-6"
  data-signature-pad
  data-tool-id={meta.id}
  data-target-option="signatureImage"
  aria-labelledby={headingId}
>
  <h2 id={headingId} class="flex items-center gap-2 text-base font-semibold text-[rgb(var(--text))]">
    <Icon name="type" size={18} /> Create your signature
  </h2>
  <p class="mt-1.5 max-w-prose text-sm leading-relaxed text-[rgb(var(--text-muted))]">
    Draw with a mouse, finger or stylus, type your name, or upload a PNG or JPEG. The signature is
    embedded into the page as flat content and never leaves your device.
  </p>

  <fieldset class="mt-4">
    <legend class="text-sm font-medium text-[rgb(var(--text))]">Signature source</legend>
    <div class="mt-1.5 flex flex-wrap gap-2">
      <label
        class="flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-[rgb(var(--bg-subtle))]"
      >
        <input
          type="radio"
          name={modeName}
          value="draw"
          class="h-4 w-4 accent-[rgb(var(--accent))]"
          data-signature-mode
          checked
        />
        <span>Draw</span>
      </label>
      <label
        class="flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-[rgb(var(--bg-subtle))]"
      >
        <input
          type="radio"
          name={modeName}
          value="type"
          class="h-4 w-4 accent-[rgb(var(--accent))]"
          data-signature-mode
        />
        <span>Type</span>
      </label>
      <label
        class="flex cursor-pointer items-center gap-2 rounded-lg border px-3 py-1.5 text-sm transition-colors hover:bg-[rgb(var(--bg-subtle))]"
      >
        <input
          type="radio"
          name={modeName}
          value="upload"
          class="h-4 w-4 accent-[rgb(var(--accent))]"
          data-signature-mode
        />
        <span>Upload</span>
      </label>
    </div>
  </fieldset>

  <div class="mt-4" data-signature-panel="draw">
    <label class="text-sm font-medium text-[rgb(var(--text))]" for={`${meta.id}-signature-canvas`}>
      Signature drawing area
    </label>
    <canvas
      id={`${meta.id}-signature-canvas`}
      data-signature-canvas
      width="640"
      height="220"
      role="img"
      aria-label="Signature drawing area. Draw with a pointer, or choose the Type option to type your name instead."
      class="mt-1.5 w-full rounded-lg border bg-white"
      style="touch-action: none"></canvas>
    <div class="mt-2 flex flex-wrap items-end gap-4">
      <div class="flex min-w-0 flex-col gap-1.5">
        <label
          class="text-xs font-medium text-[rgb(var(--text-muted))]"
          for={`${meta.id}-signature-pen-color`}>Ink</label
        >
        <select
          id={`${meta.id}-signature-pen-color`}
          data-signature-pen-color
          class="field !py-1 text-sm"
        >
          <option value="#111111" selected>Black</option>
          <option value="#1a3a7a">Blue</option>
          <option value="#5a1a1a">Dark red</option>
        </select>
      </div>
      <div class="flex min-w-0 flex-col gap-1.5">
        <label
          class="text-xs font-medium text-[rgb(var(--text-muted))]"
          for={`${meta.id}-signature-pen-width`}>Line thickness</label
        >
        <div class="flex items-center gap-3">
          <input
            id={`${meta.id}-signature-pen-width`}
            type="range"
            min="1"
            max="6"
            step="0.5"
            value="2.5"
            class="h-1.5 w-40 cursor-pointer appearance-none rounded-full accent-[rgb(var(--accent))]"
            style="background-color: rgb(var(--bg-inset))"
            data-signature-pen-width
          />
          <output
            data-signature-pen-width-out
            class="w-8 shrink-0 text-right font-mono text-sm tabular-nums text-[rgb(var(--text-muted))]"
            >2.5</output
          >
        </div>
      </div>
    </div>
  </div>

  <div class="mt-4" data-signature-panel="type" hidden>
    <div class="grid gap-4 sm:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-1.5">
        <label class="text-sm font-medium text-[rgb(var(--text))]" for={textId}>Name to sign</label>
        <input
          id={textId}
          type="text"
          class="field"
          placeholder="Your name"
          autocomplete="name"
          data-signature-text
        />
      </div>
      <div class="flex min-w-0 flex-col gap-1.5">
        <label class="text-sm font-medium text-[rgb(var(--text))]" for={`${meta.id}-signature-font`}>
          Style
        </label>
        <select id={`${meta.id}-signature-font`} class="field" data-signature-font>
          <option value='"Segoe Script", "Brush Script MT", "Lucida Handwriting", cursive' selected>
            Handwriting
          </option>
          <option value='"Snell Roundhand", "Apple Chancery", "Segoe Script", cursive'>
            Formal script
          </option>
          <option value='Georgia, "Times New Roman", serif'>Serif italic</option>
          <option value='"Courier New", "Courier", monospace'>Typewriter</option>
        </select>
      </div>
      <div class="flex min-w-0 flex-col gap-1.5">
        <label class="text-sm font-medium text-[rgb(var(--text))]" for={`${meta.id}-signature-size`}>
          Text size
        </label>
        <div class="flex items-center gap-3">
          <input
            id={`${meta.id}-signature-size`}
            type="range"
            min="24"
            max="120"
            step="1"
            value="72"
            class="h-1.5 w-full cursor-pointer appearance-none rounded-full accent-[rgb(var(--accent))]"
            style="background-color: rgb(var(--bg-inset))"
            data-signature-size
          />
          <output
            data-signature-size-out
            class="w-10 shrink-0 text-right font-mono text-sm tabular-nums text-[rgb(var(--text-muted))]"
            >72</output
          >
        </div>
      </div>
      <div class="flex min-w-0 flex-col gap-1.5">
        <label class="text-sm font-medium text-[rgb(var(--text))]" for={`${meta.id}-signature-ink`}>
          Ink
        </label>
        <select id={`${meta.id}-signature-ink`} class="field" data-signature-ink>
          <option value="#111111" selected>Black</option>
          <option value="#1a3a7a">Blue</option>
          <option value="#5a1a1a">Dark red</option>
        </select>
      </div>
    </div>
    <p class="mt-2 text-xs leading-relaxed text-[rgb(var(--text-muted))]">
      Styles use fonts installed on this device, so a typed signature may look different elsewhere.
    </p>
  </div>

  <div class="mt-4" data-signature-panel="upload" hidden>
    <label class="text-sm font-medium text-[rgb(var(--text))]" for={fileId}>
      Signature image (PNG or JPEG)
    </label>
    <input
      id={fileId}
      type="file"
      class="field mt-1.5"
      accept="image/png,image/jpeg"
      data-signature-file
    />
    <p class="mt-2 text-xs leading-relaxed text-[rgb(var(--text-muted))]">
      A transparent PNG gives the cleanest result. Large images are scaled down in this tab.
    </p>
  </div>

  <button type="button" class="btn btn-subtle btn-sm mt-3" data-signature-clear>
    Clear drawing
  </button>

  <img
    data-signature-preview
    alt="Signature preview"
    class="mt-3 max-h-24 w-auto rounded-lg border bg-white p-1"
    hidden
  />

  <p
    id={statusId}
    class="mt-3 text-sm text-[rgb(var(--text-muted))]"
    data-signature-status
    role="status"
    aria-live="polite"
  >
    No signature yet — draw, type or upload one.
  </p>

  <div
    class="mt-3 rounded-lg border px-3 py-2 text-sm"
    style="background-color: rgb(var(--danger-soft)); border-color: rgb(var(--danger)); color: rgb(var(--danger))"
    role="alert"
    data-signature-error
    hidden
  >
  </div>

  <noscript>
    <p class="mt-3 text-sm text-[rgb(var(--text-muted))]">
      Drawing needs JavaScript. You can still paste a <code>data:image/png;base64,…</code> URL into
      the “Signature image” option below.
    </p>
  </noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-signature-pad]').forEach((pad) => {
    // Loaded on demand so no pad code ships to pages that don't use it.
    void import('./signature-pad')
      .then(({ mountSignaturePad }) => mountSignaturePad(pad))
      .catch(() => {
        const error = pad.querySelector<HTMLElement>('[data-signature-error]');
        if (error) {
          error.hidden = false;
          error.textContent = 'The signature pad could not be loaded in this browser.';
        }
      });
  });
</script>
