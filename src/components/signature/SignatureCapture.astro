---
/**
 * Reusable signature capture: draw, type or upload a signature.
 *
 * The component owns the three sources and announces the result through a
 * `signaturechange` CustomEvent on its root element, so any tool can consume
 * it without knowing how the signature was made.
 */
interface Props {
  /** Prefix for the element ids — keep it unique per page. */
  idPrefix?: string;
}
const { idPrefix = 'signature' } = Astro.props;
const tabId = (tab: string) => `${idPrefix}-tab-${tab}`;
const panelId = (tab: string) => `${idPrefix}-panel-${tab}`;
const styles = [
  { value: 'script', label: 'Script' },
  { value: 'classic', label: 'Classic' },
  { value: 'modern', label: 'Modern' },
  { value: 'mono', label: 'Typewriter' },
];
const colors = [
  { value: '#111827', label: 'Black' },
  { value: '#1d4ed8', label: 'Blue' },
  { value: '#b91c1c', label: 'Red' },
  { value: '#047857', label: 'Green' },
];
---

<section class="rounded-lg border" data-signature-capture aria-label="Create your signature">
  <div
    role="tablist"
    aria-label="Signature source"
    class="flex flex-wrap gap-1 border-b p-1"
    data-signature-tabs
  >
    <button
      type="button"
      role="tab"
      id={tabId('draw')}
      aria-controls={panelId('draw')}
      aria-selected="true"
      data-signature-tab="draw"
      class="btn btn-subtle btn-sm"
    >
      Draw
    </button>
    <button
      type="button"
      role="tab"
      id={tabId('type')}
      aria-controls={panelId('type')}
      aria-selected="false"
      tabindex="-1"
      data-signature-tab="type"
      class="btn btn-subtle btn-sm"
    >
      Type
    </button>
    <button
      type="button"
      role="tab"
      id={tabId('upload')}
      aria-controls={panelId('upload')}
      aria-selected="false"
      tabindex="-1"
      data-signature-tab="upload"
      class="btn btn-subtle btn-sm"
    >
      Upload
    </button>
  </div>

  <div
    role="tabpanel"
    id={panelId('draw')}
    aria-labelledby={tabId('draw')}
    data-signature-panel="draw"
    class="p-3"
  >
    <canvas
      data-signature-canvas
      class="block w-full cursor-crosshair rounded-lg border bg-white"
      style="aspect-ratio: 10 / 3; touch-action: none"
      aria-label="Signature drawing pad. Draw your signature here with a mouse, finger or stylus."
      role="img"
    >
    </canvas>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <button type="button" class="btn btn-ghost btn-sm" data-signature-clear>Clear</button>
      <p class="text-xs text-[rgb(var(--text-muted))]" data-signature-hint>
        Draw with a mouse, finger or stylus.
      </p>
    </div>
  </div>

  <div
    role="tabpanel"
    id={panelId('type')}
    aria-labelledby={tabId('type')}
    data-signature-panel="type"
    class="p-3"
    hidden
  >
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="sm:col-span-2">
        <label class="text-xs font-medium" for={`${idPrefix}-name`}>Your name</label>
        <input
          class="field mt-1"
          id={`${idPrefix}-name`}
          type="text"
          data-signature-text
          placeholder="e.g. Ada Lovelace"
          autocomplete="name"
        />
      </div>
      <div>
        <label class="text-xs font-medium" for={`${idPrefix}-style`}>Style</label>
        <select class="field mt-1" id={`${idPrefix}-style`} data-signature-style>
          {styles.map((style) => <option value={style.value}>{style.label}</option>)}
        </select>
      </div>
      <div>
        <label class="text-xs font-medium" for={`${idPrefix}-color`}>Ink</label>
        <select class="field mt-1" id={`${idPrefix}-color`} data-signature-color>
          {colors.map((color) => <option value={color.value}>{color.label}</option>)}
        </select>
      </div>
    </div>
    <img
      data-signature-typed-preview
      alt="Preview of your typed signature"
      class="mt-3 max-h-24 w-auto rounded border bg-white p-1"
      hidden
    />
  </div>

  <div
    role="tabpanel"
    id={panelId('upload')}
    aria-labelledby={tabId('upload')}
    data-signature-panel="upload"
    class="p-3"
    hidden
  >
    <label class="text-xs font-medium" for={`${idPrefix}-file`}>Signature image (PNG)</label>
    <input
      class="field mt-1"
      id={`${idPrefix}-file`}
      type="file"
      accept="image/png"
      data-signature-file
    />
    <p class="mt-1 text-xs text-[rgb(var(--text-muted))]">
      A PNG with a transparent background gives the cleanest result.
    </p>
    <img
      data-signature-upload-preview
      alt="Preview of the uploaded signature"
      class="mt-3 max-h-24 w-auto rounded border bg-white p-1"
      hidden
    />
  </div>

  <p
    class="border-t px-3 py-2 text-xs text-[rgb(var(--text-muted))]"
    data-signature-status
    role="status"
    aria-live="polite"
  >
    No signature yet.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-signature-capture]').forEach((root) => {
    // The capture logic is loaded on demand so it only ships with the tools
    // that need it.
    void import('./signature-capture')
      .then(({ mountSignatureCapture: mount }) => mount(root))
      .catch(() => {
        const status = root.querySelector<HTMLElement>('[data-signature-status]');
        if (status) {
          status.textContent = 'The signature pad could not be loaded in this browser.';
        }
      });
  });
</script>
