---
import Icon from './Icon.astro';

/**
 * Install-as-an-app prompt (E7-T1).
 *
 * The browser fires `beforeinstallprompt` when the page is installable
 * (served over HTTPS, has a manifest + service worker). We hold the event so
 * the header button can trigger the native prompt on demand, and we let the
 * visitor dismiss the button outright — that choice is remembered in
 * `localStorage`, so it never nags again. Browsers without the event
 * (Firefox, iOS Safari) simply never see the button.
 */
---

<div id="install-prompt" class="hidden items-center gap-0.5">
  <button
    type="button"
    id="install-button"
    class="btn btn-ghost !px-2.5"
    aria-label="Install as an app"
    title="Install as an app"
  >
    <Icon name="download" size={16} />
    <span class="hidden text-[13px] font-medium sm:inline">Install app</span>
  </button>
  <button
    type="button"
    id="install-dismiss"
    class="btn btn-subtle btn-sm !px-1.5"
    aria-label="Dismiss the install prompt"
    title="Don't show this again"
  >
    <Icon name="x" size={14} />
  </button>
</div>

<script>
  interface BeforeInstallPromptEvent extends Event {
    prompt(): Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }

  const DISMISS_KEY = 'tb-install-dismissed';
  const wrap = document.getElementById('install-prompt');
  const installBtn = document.getElementById('install-button') as HTMLButtonElement | null;
  const dismissBtn = document.getElementById('install-dismiss');

  function dismissed(): boolean {
    try {
      return localStorage.getItem(DISMISS_KEY) === '1';
    } catch {
      return false;
    }
  }
  function rememberDismissal(): void {
    try {
      localStorage.setItem(DISMISS_KEY, '1');
    } catch {
      /* private mode — the button simply reappears next visit */
    }
  }
  function isStandalone(): boolean {
    return (
      window.matchMedia?.('(display-mode: standalone)').matches === true ||
      (navigator as unknown as { standalone?: boolean }).standalone === true
    );
  }

  /** Show/hide the whole install affordance (button + dismiss). */
  function showPrompt(show: boolean): void {
    if (!wrap) return;
    wrap.classList.toggle('hidden', !show);
    wrap.classList.toggle('flex', show);
  }

  let deferred: BeforeInstallPromptEvent | null = null;

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferred = e as BeforeInstallPromptEvent;
    if (!dismissed() && !isStandalone()) showPrompt(true);
  });

  // Installed — earlier this session, or by another tab. Stop offering it.
  window.addEventListener('appinstalled', () => {
    deferred = null;
    showPrompt(false);
    rememberDismissal();
  });

  // Never offer "Install app" while the site already runs as an app.
  if (isStandalone() || dismissed()) showPrompt(false);

  installBtn?.addEventListener('click', async () => {
    if (!deferred) return;
    const promptEvent = deferred;
    deferred = null;
    await promptEvent.prompt();
    const choice = await promptEvent.userChoice;
    showPrompt(false);
    if (choice.outcome === 'dismissed') rememberDismissal();
  });

  dismissBtn?.addEventListener('click', () => {
    deferred = null;
    showPrompt(false);
    rememberDismissal();
  });
</script>
