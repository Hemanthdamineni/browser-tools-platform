---
import { site } from '@/lib/site';
import Icon from './Icon.astro';
import InstallButton from './InstallButton.astro';
import ShortcutsDialog from './ShortcutsDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
// Asset/link paths must honour the deploy base (e.g. /browser-tools-platform on GitHub Pages).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header
  class="sticky top-0 z-40 border-b"
  style="background-color: rgb(var(--bg) / 0.85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px)"
>
  <div class="mx-auto flex h-14 max-w-content items-center gap-3 px-4 sm:px-6">
    <a
      href={`${base}/`}
      class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight"
      aria-label={`${site.shortName} home`}
    >
      <span
        class="grid h-7 w-7 place-items-center rounded-md"
        style="background: rgb(var(--text)); color: rgb(var(--bg))"
        aria-hidden="true"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path
            d="M14.7 6.3a5 5 0 0 0-6.4 6.4L4 17v3h3l4.3-4.3a5 5 0 0 0 6.4-6.4L14 8.6l-1.6 1.6-1.6-1.6 3.9-3.9z"
          ></path></svg
        >
      </span>
      <span class="tracking-tight">{site.shortName}</span>
    </a>

    <nav class="ml-2 hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'text-[rgb(var(--accent))]'
                : 'text-[rgb(var(--text-muted))] hover:text-[rgb(var(--text))] hover:bg-[rgb(var(--bg-inset))]',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        id="search-open"
        class="btn btn-subtle btn-sm gap-2 !px-2.5 text-[rgb(var(--text-muted))] sm:!px-3"
        aria-label="Search tools"
        aria-keyshortcuts="/"
      >
        <Icon name="search" size={16} />
        <span class="hidden text-[13px] font-medium sm:inline">Search</span>
        <kbd class="kbd hidden sm:inline-flex">/</kbd>
      </button>
      <InstallButton />
      <ThemeToggle />
      <button
        type="button"
        id="shortcuts-open"
        class="btn btn-subtle btn-sm !px-2"
        aria-label="Keyboard shortcuts"
        aria-keyshortcuts="?"
        title="Keyboard shortcuts (?)"
      >
        <Icon name="info" size={16} />
      </button>
      <button
        type="button"
        id="menu-toggle"
        class="btn btn-subtle btn-sm !px-2 md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <nav id="mobile-nav" hidden class="border-t px-4 py-2 md:hidden" aria-label="Mobile">
    {
      site.nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block rounded-md px-3 py-2.5 text-[15px] font-medium',
            isActive(item.href)
              ? 'text-[rgb(var(--accent))]'
              : 'text-[rgb(var(--text))] hover:bg-[rgb(var(--bg-inset))]',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<ShortcutsDialog />

<script>
  import { isTypingTarget } from '@/components/keyboard';

  const btn = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');

  function setOpen(open: boolean) {
    if (!nav || !btn) return;
    if (open) nav.removeAttribute('hidden');
    else nav.setAttribute('hidden', '');
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  }

  btn?.addEventListener('click', () => setOpen(nav?.hasAttribute('hidden') ?? true));

  // Close on Escape (and return focus to the toggle).
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && nav && !nav.hasAttribute('hidden')) {
      setOpen(false);
      btn?.focus();
    }
  });

  // Close when the user clicks outside the header on mobile.
  document.addEventListener('click', (e) => {
    if (nav && !nav.hasAttribute('hidden')) {
      const t = e.target as Node;
      const header = document.querySelector('header');
      if (header && !header.contains(t)) setOpen(false);
    }
  });

  // Close when a mobile link is navigated.
  nav?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });

  document.getElementById('search-open')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('toolbench:search'));
  });

  // Page-wide chords. Character chords are ignored while typing; modifier
  // chords never produce characters, so they are honoured everywhere.
  window.addEventListener('keydown', (e) => {
    // '?' opens the shortcuts help dialog.
    if (e.key === '?' && !e.ctrlKey && !e.metaKey && !e.altKey && !isTypingTarget(e.target)) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('toolbench:shortcuts'));
      return;
    }
    // Ctrl/Cmd+Enter runs the current tool. A modifier chord types no
    // characters, so it is honoured even with focus in the input field.
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('toolbench:run'));
      return;
    }
  });

  // The original '/' handler — kept for the header-scoped behaviour above.
  window.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '/' && !/^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName) && !t.isContentEditable) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('toolbench:search'));
    }
  });

  // A new service worker finished installing while an older one is still in
  // charge of this page. Ask it to take over (`skip-waiting`) and offer a
  // reload — the page's own assets are still the old ones until it does.
  if ('serviceWorker' in navigator) {
    let announced = false;
    const announce = () => {
      if (announced) return;
      announced = true;
      showUpdateToast();
    };
    const watch = (registration: ServiceWorkerRegistration) => {
      registration.addEventListener('updatefound', () => {
        const installing = registration.installing;
        if (!installing) return;
        installing.addEventListener('statechange', () => {
          // `controller` non-null means an older worker owns this page, so the
          // freshly installed one is a genuine update rather than first install.
          if (installing.state === 'installed' && navigator.serviceWorker.controller) {
            registration.waiting?.postMessage('skip-waiting');
            announce();
          }
        });
      });
    };
    navigator.serviceWorker.ready.then(watch).catch(() => {
      /* offline support is a progressive enhancement */
    });
    navigator.serviceWorker.addEventListener('controllerchange', () => {
      // A reload already happened (or another tab activated the update); keep
      // the toast from lingering with a stale message.
      document.querySelector('[data-update-toast]')?.remove();
    });
  }

  function showUpdateToast() {
    const host = document.getElementById('toast');
    if (!host || document.querySelector('[data-update-toast]')) return;
    const box = document.createElement('div');
    box.setAttribute('data-update-toast', '');
    box.className =
      'pointer-events-auto flex items-center gap-3 rounded-lg border px-4 py-2 text-sm shadow-lg animate-slide-up';
    box.style.backgroundColor = 'rgb(var(--bg))';
    const message = document.createElement('span');
    message.textContent = 'A new version is available.';
    const reload = document.createElement('button');
    reload.type = 'button';
    reload.className = 'btn btn-primary btn-sm';
    reload.textContent = 'Reload';
    reload.addEventListener('click', () => window.location.reload());
    const later = document.createElement('button');
    later.type = 'button';
    later.className = 'btn btn-subtle btn-sm';
    later.textContent = 'Later';
    later.setAttribute('aria-label', 'Dismiss the update notice');
    later.addEventListener('click', () => box.remove());
    box.append(message, reload, later);
    host.appendChild(box);
  }
</script>
