---
import type { Category } from '@/lib/types';
import Icon from './Icon.astro';

interface Props {
  category: Category & { count: number };
}
const { category } = Astro.props;
---

<a
  href={`/categories/${category.id}`}
  class="group flex items-baseline gap-3 border-b py-3.5 transition-colors hover:border-[rgb(var(--border-strong))]"
>
  <span
    class="shrink-0 text-[rgb(var(--text-faint))] transition-colors group-hover:text-[rgb(var(--accent))]"
    aria-hidden="true"
  >
    <Icon name={category.icon} size={16} />
  </span>
  <span class="min-w-0 flex-1">
    <span class="flex items-baseline gap-2">
      <span class="font-medium tracking-[-0.01em] text-[rgb(var(--text))]">{category.name}</span>
      <span class="shrink-0 font-mono text-[11px] tabular-nums text-[rgb(var(--text-faint))]"
        >{category.count}</span
      >
    </span>
    <span class="mt-0.5 block text-[13px] leading-relaxed text-[rgb(var(--text-muted))]"
      >{category.blurb}</span
    >
  </span>
  <Icon
    name="arrow-right"
    size={14}
    class="shrink-0 self-center text-[rgb(var(--text-faint))] opacity-0 transition-opacity group-hover:opacity-100"
  />
</a>
